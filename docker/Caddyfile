{
	# Disable FrankenPHP's automatic HTTPS — Traefik terminates TLS for us.
	frankenphp
	auto_https off
}

# Serve plain HTTP on :80; Traefik handles the public HTTPS endpoint.
:80 {
	root * /app/public
	encode zstd br gzip

	# Security headers (defense in depth). The CSP allows inline script/style
	# because AssetMapper emits an inline importmap and a few templates carry
	# inline <style>/<script>; everything else is same-origin. Could be tightened
	# with nonces later. The actual stored-XSS sink is sanitized server-side.
	# NOTE: the CSP lives in the matcher-scoped blocks below — this block is
	# deferred by the -Server delete and would overwrite them at write time.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Authenticated/private areas must never be cached (browser cache or SW).
	# Their CSP additionally allows external https images: the backend previews
	# unapproved images straight from the source sites (Freigabe/dedup review).
	@private path /admin /admin/* /login /logout
	header @private {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Public pages keep the strict same-origin img-src (event images go through
	# the caching proxy under /img).
	@public not path /admin /admin/* /login /logout
	header @public Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# Content-hashed assets + self-hosted fonts can be cached forever.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Symfony front controller
	php_server

	log {
		output stdout
		format console
	}
}
