{
	# Disable FrankenPHP's automatic HTTPS — Traefik terminates TLS for us.
	frankenphp
	auto_https off
}

# Serve plain HTTP on :80; Traefik handles the public HTTPS endpoint.
:80 {
	root * /app/public
	encode zstd br gzip

	# Content-hashed assets + self-hosted fonts can be cached forever.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Symfony front controller
	php_server

	log {
		output stdout
		format console
	}
}
