{# Compact one-line event row: category dot + title + time/location.
   Used by the mobile calendar views. Expects `event`. #}
{% set soldOut = event.bookingStatus and event.bookingStatus.isSoldOut %}
<a href="{{ path('event_show', {id: event.id, slug: event.slug}) }}" class="flex items-start gap-2.5 py-2 group {{ soldOut ? 'opacity-55' }}">
    <span class="mt-1.5 w-2.5 h-2.5 rounded-full shrink-0" style="background: {{ event.category ? event.category.color : 'var(--color-brand-500)' }}"></span>
    <span class="min-w-0 flex-1">
        <span class="block text-sm font-medium text-ink leading-snug line-clamp-2 group-hover:text-brand-700 transition {{ soldOut ? 'line-through' }}">{{ event.title }}</span>
        <span class="block text-xs text-ink/50 line-clamp-1">
            {% if event.allDay %}ganztägig{% else %}{{ event.startsAt|date('H:i') }} Uhr{% endif %}
            {%- if event.displayLocation %} · {{ event.venue ? event.venue.name : event.locationText }}{% endif %}
            {%- if event.bookingStatus and event.bookingStatus.showBadge %} · {{ event.bookingStatus.label }}{% endif %}
        </span>
    </span>
</a>
