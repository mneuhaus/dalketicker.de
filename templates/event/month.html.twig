{% extends 'base.html.twig' %}

{% block title %}Kalender {{ monthDate.format('n')|de_month }} {{ monthDate|date('Y') }} – {{ site_name }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-6 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-extrabold tracking-tight text-ink">
            {{ (monthDate.format('n'))|de_month }} {{ monthDate|date('Y') }}
        </h1>
        <div class="flex items-center gap-2">
            <a href="{{ path('event_month', {year: prev|date('Y'), month: prev|date('n')}) }}" class="chip-muted" aria-label="Vorheriger Monat">←</a>
            <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="chip-muted">Heute</a>
            <a href="{{ path('event_month', {year: next|date('Y'), month: next|date('n')}) }}" class="chip-muted" aria-label="Nächster Monat">→</a>
        </div>
    </div>

    {{ include('event/_filters.html.twig') }}

    <div class="bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
        <div class="grid grid-cols-7 text-center text-xs font-semibold text-ink/50 border-b border-black/5">
            {% for d in ['Mo','Di','Mi','Do','Fr','Sa','So'] %}
                <div class="py-2">{{ d }}</div>
            {% endfor %}
        </div>
        <div class="grid grid-cols-7">
            {% for week in weeks %}
                {% for cell in week %}
                    {% set isToday = cell.date|date('Y-m-d') == today|date('Y-m-d') %}
                    <div class="min-h-[7rem] border-b border-r border-black/5 p-1.5 {{ cell.inMonth ? '' : 'bg-black/[0.02]' }} {{ loop.last ? 'border-r-0' }}">
                        <div class="text-xs font-semibold mb-1 flex justify-end">
                            <span class="{{ isToday ? 'bg-brand-600 text-white rounded-full w-5 h-5 inline-flex items-center justify-center' : (cell.inMonth ? 'text-ink/60' : 'text-ink/25') }}">
                                {{ cell.date|date('j') }}
                            </span>
                        </div>
                        <div class="space-y-1">
                            {% for event in cell.events|slice(0, 4) %}
                                <a href="{{ path('event_show', {id: event.id, slug: event.slug}) }}"
                                   class="block text-[11px] leading-tight rounded px-1.5 py-1 truncate hover:opacity-80 transition"
                                   style="background-color: {{ event.category ? event.category.color ~ '22' : 'rgba(0,0,0,0.05)' }}; border-left: 3px solid {{ event.category ? event.category.color : 'var(--color-brand-500)' }}"
                                   title="{{ event.title }}{% if not event.allDay %} · {{ event.startsAt|date('H:i') }} Uhr{% endif %}">
                                    {% if not event.allDay %}<span class="font-semibold">{{ event.startsAt|date('H:i') }}</span> {% endif %}{{ event.title }}
                                </a>
                            {% endfor %}
                            {% if cell.events|length > 4 %}
                                <div class="text-[10px] text-ink/40 px-1">+{{ cell.events|length - 4 }} mehr</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
{% endblock %}
