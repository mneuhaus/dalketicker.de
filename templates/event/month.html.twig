{% extends 'layout_with_sidebar.html.twig' %}

{% block title %}Kalender {{ monthDate.format('n')|de_month }} {{ monthDate|date('Y') }} – {{ site_name }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-extrabold tracking-tight text-ink">
            {{ monthDate.format('n')|de_month }} {{ monthDate|date('Y') }}
        </h1>
        <div class="flex items-center gap-2">
            <a href="{{ path('event_month', {year: prev|date('Y'), month: prev|date('n')}) }}" class="chip-muted" aria-label="Vorheriger Monat">←</a>
            <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="chip-muted">Heute</a>
            <a href="{{ path('event_month', {year: next|date('Y'), month: next|date('n')}) }}" class="chip-muted" aria-label="Nächster Monat">→</a>
        </div>
    </div>

    {% if groups is empty %}
        <div class="text-center py-20 text-ink/50 border border-dashed border-black/10 rounded-2xl">
            <p class="font-medium text-ink/70">In diesem Monat ist (noch) nichts eingetragen.</p>
            <p class="text-sm mt-1">Blättere zu einem anderen Monat oder pass die Filter an.</p>
        </div>
    {% else %}
        <div class="space-y-8">
            {% for group in groups %}
                <section>
                    <div class="flex items-baseline gap-3 mb-3 sticky top-16 bg-paper/95 backdrop-blur py-1 z-10">
                        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-brand-800">{{ group.date|de_day_label }}</h2>
                        <span class="text-xs text-ink/40">{{ group.events|length }} Termin{{ group.events|length == 1 ? '' : 'e' }}</span>
                        <span class="flex-1 border-b border-dashed border-black/10"></span>
                    </div>
                    <div class="grid gap-3">
                        {% for event in group.events %}
                            {{ include('event/_card.html.twig', {event: event}) }}
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
