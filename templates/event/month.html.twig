{% extends 'layout_with_sidebar.html.twig' %}

{% block title %}Kalender {{ monthDate.format('n')|de_month }} {{ monthDate|date('Y') }} – {{ site_name }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-3 sm:gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
            {{ monthDate.format('n')|de_month }} {{ monthDate|date('Y') }}
        </h1>
        <div class="flex items-center gap-2">
            <a href="{{ path('event_month', {year: prev|date('Y'), month: prev|date('n')}) }}" class="chip-muted" aria-label="Vorheriger Monat">←</a>
            <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="chip-muted">Heute</a>
            <a href="{{ path('event_month', {year: next|date('Y'), month: next|date('n')}) }}" class="chip-muted" aria-label="Nächster Monat">→</a>
        </div>
    </div>

    {# Desktop / tablet: full calendar grid with readable event cards. #}
    <div class="hidden md:block bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
        <div class="grid grid-cols-7 text-center text-xs font-semibold text-ink/50 border-b border-black/5">
            {% for d in ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag'] %}
                <div class="py-2">{{ d }}</div>
            {% endfor %}
        </div>
        <div class="grid grid-cols-7">
            {% for week in weeks %}
                {% for cell in week %}
                    {% set isToday = cell.date|date('Y-m-d') == today|date('Y-m-d') %}
                    <div class="min-h-[9.5rem] border-b border-r border-black/5 p-2 align-top {{ cell.inMonth ? '' : 'bg-black/[0.02]' }} {{ loop.last ? 'border-r-0' }}">
                        <div class="mb-1.5 flex justify-end">
                            <span class="text-xs font-semibold {{ isToday ? 'bg-brand-600 text-white rounded-full w-6 h-6 inline-flex items-center justify-center' : (cell.inMonth ? 'text-ink/60' : 'text-ink/25') }}">
                                {{ cell.date|date('j') }}
                            </span>
                        </div>
                        <div class="space-y-1.5">
                            {% for event in cell.events|slice(0, 3) %}
                                {% set color = event.category ? event.category.color : 'var(--color-brand-500)' %}
                                <a href="{{ path('event_show', {id: event.id, slug: event.slug}) }}"
                                   class="block rounded-lg p-1.5 hover:shadow-sm transition leading-tight"
                                   style="background-color: {{ event.category ? event.category.color ~ '1a' : 'rgba(0,0,0,0.04)' }}; border-left: 3px solid {{ color }}"
                                   title="{{ event.title }}">
                                    <div class="text-[11px] font-semibold" style="color: {{ color }}">
                                        {% if event.allDay %}ganztags{% else %}{{ event.startsAt|date('H:i') }} Uhr{% endif %}
                                    </div>
                                    <div class="text-xs font-medium text-ink line-clamp-2">{{ event.title }}</div>
                                    {% if event.displayLocation %}
                                        <div class="text-[10px] text-ink/50 line-clamp-1 mt-0.5">{{ event.venue ? event.venue.name : event.locationText }}</div>
                                    {% endif %}
                                </a>
                            {% endfor %}
                            {% if cell.events|length > 3 %}
                                <div class="text-[11px] text-ink/40 px-1">+{{ cell.events|length - 3 }} weitere</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>

    {# Mobile: a 7-column grid is unusable, so fall back to the day agenda. #}
    <div class="md:hidden">
        {% if groups is empty %}
            <div class="text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                <p class="font-medium text-ink/70">In diesem Monat ist (noch) nichts eingetragen.</p>
            </div>
        {% else %}
            <div class="space-y-8">
                {% for group in groups %}
                    <section>
                        <div class="flex items-baseline gap-3 mb-3">
                            <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-brand-800">{{ group.date|de_day_label }}</h2>
                            <span class="text-xs text-ink/40">{{ group.events|length }} Termin{{ group.events|length == 1 ? '' : 'e' }}</span>
                            <span class="flex-1 border-b border-dashed border-black/10"></span>
                        </div>
                        <div class="grid grid-cols-1 gap-3">
                            {% for event in group.events %}
                                {{ include('event/_card.html.twig', {event: event}) }}
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
