{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} – {{ site_name }}{% endblock %}
{% block meta_description %}{{ event.description ? event.description|striptags|slice(0, 160) : event.title }}{% endblock %}

{% macro meta_icon(name) %}
    {% set paths = {
        'calendar': 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
        'pin': 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
        'ticket': 'M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-3a2 2 0 000-4V7a2 2 0 012-2z',
        'user': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
    } %}
    <svg class="w-5 h-5 text-brand-600 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="{{ paths[name] }}"/></svg>
{% endmacro %}

{% macro neighbor(e, filter) %}
    <a href="{{ path('event_show', {id: e.id, slug: e.slug}|merge(filter.toQueryParams|default({}))) }}"
       class="block rounded-xl border border-black/5 bg-white p-3 hover:border-brand-200 hover:shadow-sm transition">
        <div class="text-xs font-semibold" style="color: {{ e.category ? e.category.color : 'var(--color-brand-700)' }}">
            {{ e.startsAt|de_date }}{% if not e.allDay %} · {{ e.startsAt|date('H:i') }}{% endif %}
        </div>
        <div class="text-sm font-medium text-ink leading-snug line-clamp-2 mt-0.5">{{ e.title }}</div>
        {% if e.displayLocation %}<div class="text-xs text-ink/50 line-clamp-1 mt-0.5">{{ e.displayLocation }}</div>{% endif %}
    </a>
{% endmacro %}

{% block body %}
    {% import _self as ui %}
    <a href="{{ path('event_index', filter.toQueryParams|default({})) }}" class="text-sm text-ink/50 hover:text-brand-700 inline-flex items-center gap-1 mb-4">← Alle Veranstaltungen</a>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-6 lg:items-start">
    <article class="bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
        {% if event.imageUrl %}
            <img src="{{ event.imageUrl }}" alt="" class="w-full max-h-80 object-cover">
        {% endif %}
        <div class="p-6 sm:p-8">
            {% if event.category %}
                <span class="chip text-white text-xs mb-3" style="background-color: {{ event.category.color }}">{{ event.category.name }}</span>
            {% endif %}
            <h1 class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">{{ event.title }}</h1>

            <div class="grid sm:grid-cols-2 gap-4 mt-6">
                <div class="flex items-start gap-3">
                    {{ ui.meta_icon('calendar') }}
                    <div>
                        <div class="font-semibold text-ink">{{ event.startsAt|de_weekday(true) }}, {{ event.startsAt|de_date(true) }}</div>
                        <div class="text-ink/60 text-sm">
                            {% if event.allDay %}ganztägig{% else %}{{ event.startsAt|de_time }}{% if event.endsAt %} – {{ event.endsAt|date('H:i') }} Uhr{% endif %}{% endif %}
                        </div>
                    </div>
                </div>
                {% if event.displayLocation %}
                    <div class="flex items-start gap-3">
                        {{ ui.meta_icon('pin') }}
                        <div>
                            <div class="font-semibold text-ink">{{ event.venue ? event.venue.name : event.locationText }}</div>
                            {% if event.venue and event.venue.fullAddress %}
                                <div class="text-ink/60 text-sm">{{ event.venue.fullAddress }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                {% if event.price %}
                    <div class="flex items-start gap-3">{{ ui.meta_icon('ticket') }}<div class="font-semibold text-ink">{{ event.price }}</div></div>
                {% endif %}
                {% if event.organizer %}
                    <div class="flex items-start gap-3">{{ ui.meta_icon('user') }}<div><div class="text-ink/60 text-sm">Veranstalter</div><div class="font-semibold text-ink">{{ event.organizer }}</div></div></div>
                {% endif %}
            </div>

            {% if event.description %}
                <div class="prose prose-sm max-w-none mt-6 text-ink/80 whitespace-pre-line">{{ event.description|striptags("<br><p><a><strong><em><ul><ol><li>")|raw }}</div>
            {% endif %}

            <div class="mt-8 pt-6 border-t border-black/5 flex flex-wrap items-center gap-3 justify-between">
                <span class="text-xs text-ink/40">Quelle: {{ event.source.name }}</span>
                <div class="flex items-center gap-2">
                    <button type="button" data-save-btn data-event-id="{{ event.id }}" aria-pressed="false"
                            class="save-btn inline-flex items-center gap-2 rounded-xl border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                        Merken
                    </button>
                    {% if event.sourceUrl %}
                        <a href="{{ event.sourceUrl }}" target="_blank" rel="noopener" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition">
                            Zum Veranstalter ↗
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </article>

    {% if before or after %}
        <aside class="mt-6 lg:mt-0 space-y-6">
            {% if after %}
                <div>
                    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Danach</h2>
                    <div class="space-y-2">
                        {% for e in after %}{{ ui.neighbor(e, filter) }}{% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if before %}
                <div>
                    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Davor</h2>
                    <div class="space-y-2">
                        {% for e in before %}{{ ui.neighbor(e, filter) }}{% endfor %}
                    </div>
                </div>
            {% endif %}
        </aside>
    {% endif %}
    </div>
{% endblock %}
