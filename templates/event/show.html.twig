{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} – {{ site_name }}{% endblock %}
{% block meta_description %}{{ event.description ? event.description|striptags|slice(0, 160) : event.title }}{% endblock %}
{# Share preview: this event's own image + title. #}
{% block og_title %}{{ event.title }}{% endblock %}
{% block og_image %}{% if event.imageUrl %}{{ app.request.schemeAndHttpHost }}{{ path('image_proxy', {id: event.id}) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% macro meta_icon(name) %}
    {% set paths = {
        'pin': 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
        'ticket': 'M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-3a2 2 0 000-4V7a2 2 0 012-2z',
        'user': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
    } %}
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="{{ paths[name] }}"/></svg>
{% endmacro %}

{% macro neighbor(e, filter) %}
    <a href="{{ path('event_show', {id: e.id, slug: e.slug}|merge(filter.toQueryParams|default({}))) }}"
       class="flex gap-3 rounded-xl border border-black/5 bg-white p-2.5 hover:border-brand-200 hover:shadow-sm transition">
        {% if e.imageUrl %}
            <div class="shrink-0 w-14 h-14 rounded-lg overflow-hidden bg-black/5">
                <img src="{{ path('image_proxy', {id: e.id}) }}" alt="" loading="lazy" class="w-full h-full object-cover">
            </div>
        {% endif %}
        <div class="min-w-0">
            <div class="text-xs font-semibold" style="color: {{ e.category ? e.category.color : 'var(--color-brand-700)' }}">
                {{ e.startsAt|de_date }}{% if not e.allDay %} · {{ e.startsAt|date('H:i') }}{% endif %}
            </div>
            <div class="text-sm font-medium text-ink leading-snug line-clamp-2">{{ e.title }}</div>
            {% if e.displayLocation %}<div class="text-xs text-ink/50 line-clamp-1">{{ e.displayLocation }}</div>{% endif %}
        </div>
    </a>
{% endmacro %}

{% block body %}
    {% import _self as ui %}
    {% set color = event.category ? event.category.color : 'var(--color-brand-600)' %}
    {% set multiDay = event.endsAt and event.endsAt|date('Y-m-d') != event.startsAt|date('Y-m-d') %}
    {% set prev = before ? before|last : null %}
    {% set next = after ? after|first : null %}
    {% set prevUrl = prev ? path('event_show', {id: prev.id, slug: prev.slug}|merge(filter.toQueryParams|default({}))) : '' %}
    {% set nextUrl = next ? path('event_show', {id: next.id, slug: next.slug}|merge(filter.toQueryParams|default({}))) : '' %}

    <a href="{{ path('event_index', filter.toQueryParams|default({})) }}" class="text-sm text-ink/50 hover:text-brand-700 inline-flex items-center gap-1 mb-4">← Alle Veranstaltungen</a>

    <div data-event-nav data-event-id="{{ event.id }}" data-prev-url="{{ prevUrl }}" data-next-url="{{ nextUrl }}"
         class="lg:grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-6 lg:items-start">

        {# Left column: the detail box + the previous/next row beneath it #}
        <div class="min-w-0">
            <article data-evdetail class="evdetail bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden">
                {% if event.imageUrl %}
                    <div class="evimg-wrap">
                        <img data-evimg src="{{ path('image_proxy', {id: event.id}) }}" alt="" class="evimg">
                    </div>
                {% endif %}

                <div class="evbody p-6 sm:p-8">
                    {% if event.categories|length or event.isCourse or (event.bookingStatus and event.bookingStatus.showBadge) %}
                        <div class="mb-3 flex flex-wrap items-center gap-2">
                            {% for category in event.categories %}
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold text-white" style="background-color: {{ category.color }}">{{ category.name }}</span>
                            {% endfor %}
                            {% if event.isCourse %}
                                <span class="inline-flex items-center rounded-full bg-black/5 px-2.5 py-1 text-xs font-semibold text-ink/55">Kurs</span>
                            {% endif %}
                            {% if event.bookingStatus and event.bookingStatus.showBadge %}
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold {{ event.bookingStatus.badgeClasses }}">{{ event.bookingStatus.label }}</span>
                            {% endif %}
                        </div>
                    {% endif %}

                    <h1 class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">{{ event.title }}</h1>

                    {# When — the prominent secondary line #}
                    <p class="mt-3 text-lg font-semibold text-brand-800">
                        {% if multiDay %}
                            {{ event.startsAt|de_weekday }}, {{ event.startsAt|de_date }} – {{ event.endsAt|de_weekday }}, {{ event.endsAt|de_date(true) }}{% if not event.allDay %} · {{ event.startsAt|de_time }}{% endif %}
                        {% else %}
                            {{ event.startsAt|de_weekday(true) }}, {{ event.startsAt|de_date(true) }}{% if not event.allDay %} · {{ event.startsAt|de_time }}{% if event.endsAt %}–{{ event.endsAt|date('H:i') }} Uhr{% endif %}{% endif %}
                        {% endif %}
                        {% if event.allDay %}<span class="text-ink/40 font-normal">· ganztägig</span>{% endif %}
                    </p>

                    {# Secondary tags #}
                    {% if event.price or event.organizer %}
                        <div class="mt-4 flex flex-wrap gap-2 text-sm">
                            {% if event.price %}
                                <span class="inline-flex items-center gap-1.5 rounded-lg bg-black/5 px-2.5 py-1 text-ink/70">{{ ui.meta_icon('ticket') }}{{ event.price }}</span>
                            {% endif %}
                            {% if event.organizer %}
                                <span class="inline-flex items-center gap-1.5 rounded-lg bg-black/5 px-2.5 py-1 text-ink/70">{{ ui.meta_icon('user') }}{{ event.organizer }}</span>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if event.description %}
                        <div class="prose prose-sm max-w-none mt-6 text-ink/80 whitespace-pre-line">{{ event.description|striptags("<br><p><a><strong><em><ul><ol><li>")|raw }}</div>
                    {% endif %}

                    <div class="mt-8 pt-5 border-t border-black/5 flex justify-end gap-2">
                        <button type="button" data-share
                                data-share-title="{{ event.title }}"
                                data-share-url="{{ app.request.schemeAndHttpHost }}{{ path('event_show', {id: event.id, slug: event.slug}) }}"
                                class="inline-flex items-center gap-2 rounded-xl border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/></svg>
                            <span data-share-label>Teilen</span>
                        </button>
                        <button type="button" data-save-btn data-event-id="{{ event.id }}" aria-pressed="false"
                                class="save-btn inline-flex items-center gap-2 rounded-xl border border-black/10 px-4 py-2.5 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                            Merken
                        </button>
                    </div>
                </div>
            </article>

            {# Previous / next in the current list — three columns, middle left empty #}
            {% if prev or next %}
                <nav class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4" aria-label="Vorheriges und nächstes Event">
                    <div>
                        {% if prev %}
                            <div class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">← Vorherige</div>
                            {{ ui.neighbor(prev, filter) }}
                        {% endif %}
                    </div>
                    <div class="hidden sm:block"></div>
                    <div>
                        {% if next %}
                            <div class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2 text-right">Nächste →</div>
                            {{ ui.neighbor(next, filter) }}
                        {% endif %}
                    </div>
                </nav>
            {% endif %}
        </div>

        {# Right column: where + organizer link #}
        <aside class="mt-6 lg:mt-0 space-y-4">
            {% if event.displayLocation %}
                <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5">
                    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Ort</h2>
                    <div class="flex items-start gap-2 text-sm">
                        <span class="text-brand-600 mt-0.5">{{ ui.meta_icon('pin') }}</span>
                        <div class="min-w-0">
                            <div class="text-ink font-medium">{{ event.venue ? event.venue.name : event.locationText }}</div>
                            {% if event.venue and event.venue.city %}<div class="text-ink/60">{{ event.venue.city }}</div>{% endif %}
                            {% if event.venue and event.venue.fullAddress %}<div class="text-ink/45 text-xs mt-0.5">{{ event.venue.fullAddress }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if event.sourceUrl %}
                <a href="{{ event.sourceUrl }}" target="_blank" rel="noopener"
                   class="block text-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700 transition">Zur Veranstaltungsseite ↗</a>
            {% endif %}

            <p class="text-xs text-ink/40 px-1">
                Quelle:
                {% if sourceHome %}
                    <a href="{{ sourceHome }}" target="_blank" rel="noopener" class="hover:text-ink/60 hover:underline">{{ event.source.name }}</a>
                {% else %}
                    {{ event.source.name }}
                {% endif %}
            </p>
        </aside>
    </div>

    {{ include('event/_image_fit.html.twig') }}
{% endblock %}
