{# Filter bar — submits via GET to the current route so it works on both views. #}
<form method="get" action="{{ app.request.pathInfo }}" class="bg-white rounded-2xl border border-black/5 shadow-sm p-4 mb-6">
    <div class="flex flex-col md:flex-row gap-3">
        <div class="flex-1 relative">
            <input type="search" name="q" value="{{ filter.q }}" placeholder="Suche nach Titel, Ort, Stichwort…"
                   class="w-full rounded-xl border border-black/10 bg-paper px-4 py-2.5 pl-10 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none">
            <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
        </div>
        <select name="ort" class="rounded-xl border border-black/10 bg-paper px-3 py-2.5 text-sm focus:border-brand-500 outline-none">
            <option value="">Alle Orte</option>
            {% for city in allCities %}
                <option value="{{ city }}" {{ filter.city == city ? 'selected' }}>{{ city }}</option>
            {% endfor %}
        </select>
        <select name="quelle" class="rounded-xl border border-black/10 bg-paper px-3 py-2.5 text-sm focus:border-brand-500 outline-none">
            <option value="">Alle Quellen</option>
            {% for source in allSources %}
                <option value="{{ source.key }}" {{ filter.sourceKey == source.key ? 'selected' }}>{{ source.name }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition">Filtern</button>
    </div>

    <div class="flex flex-wrap items-center gap-2 mt-4">
        <a href="{{ path('event_index') }}" class="{{ filter.categorySlug is null ? 'chip-active' : 'chip-muted' }}">Alles</a>
        {% for category in allCategories %}
            <a href="{{ path('event_index', {kategorie: category.slug}) }}"
               class="{{ filter.categorySlug == category.slug ? 'chip-active' : 'chip-muted' }}"
               style="{{ filter.categorySlug == category.slug ? '' : 'color:' ~ category.color }}">
                {% if category.icon %}{{ category.icon }} {% endif %}{{ category.name }}
            </a>
        {% endfor %}
    </div>

    {% if filter.hasAny %}
        <div class="mt-3 text-xs text-ink/50">
            <a href="{{ app.request.pathInfo }}" class="underline hover:text-brand-700">Filter zurücksetzen</a>
        </div>
    {% endif %}
</form>
