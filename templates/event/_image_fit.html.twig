{# Shared, self-contained image handling — honours the diverse source image
   formats without cropping, distorting or upscaling them:
     - detail page ([data-evdetail]): landscape → banner on top; portrait,
       square or small → smaller image beside the text (left).
     - cards (.card-media): image sits right of the text and "breathes" to its
       own aspect (within caps); never upscaled past its native pixels.
     - "Heute?" (.fitcap): full image, contained, never upscaled.
   Include once per page that shows event images. #}
<style>
    /* --- Detail page --- */
    .evdetail .evimg{ display:block; width:100%; height:auto; max-width:var(--evnatw,100%); margin-inline:auto; }
    @media (min-width:640px){
        .evdetail.is-portrait, .evdetail.is-square, .evdetail.is-small{ display:flex; align-items:flex-start; }
        .evdetail.is-portrait>.evimg-wrap, .evdetail.is-square>.evimg-wrap, .evdetail.is-small>.evimg-wrap{ flex:0 0 auto; padding:1.5rem 0 1.5rem 1.5rem; }
        .evdetail.is-portrait>.evimg-wrap .evimg{ width:14rem; border-radius:.75rem; }
        .evdetail.is-square>.evimg-wrap .evimg{ width:16rem; border-radius:.75rem; }
        .evdetail.is-small>.evimg-wrap .evimg{ width:13rem; border-radius:.75rem; }
        .evdetail.is-portrait>.evbody, .evdetail.is-square>.evbody, .evdetail.is-small>.evbody{ flex:1 1 0; min-width:0; }
    }
    @media (max-width:639px){
        .evdetail.is-portrait>.evimg-wrap, .evdetail.is-square>.evimg-wrap, .evdetail.is-small>.evimg-wrap{ padding:1.5rem 1.5rem 0; }
        .evdetail.is-portrait>.evimg-wrap .evimg, .evdetail.is-square>.evimg-wrap .evimg, .evdetail.is-small>.evimg-wrap .evimg{ max-width:min(70%, var(--evnatw,70%)); border-radius:.75rem; }
    }

    /* --- Cards: image right of the text, sized to its own aspect, never upscaled.
       width/height:auto + max-* means the intrinsic (native) size is the ceiling. --- */
    .card-media{ display:flex; flex-direction:row-reverse; align-items:flex-start; }
    .card-media>.cm-img{ flex:0 0 auto; padding:.75rem; }
    .card-media .cm-img-el{ display:block; width:auto; height:auto; max-width:8.5rem; max-height:7.5rem; border-radius:.6rem; object-fit:contain; }
    @media (min-width:640px){ .card-media .cm-img-el{ max-width:13rem; max-height:10rem; } }
    .card-media>.cm-body{ flex:1 1 0; min-width:0; }

    /* --- "Heute?" single card: contained, never upscaled --- */
    .fitcap{ display:block; margin-inline:auto; width:auto; height:auto; max-width:100%; max-height:18rem; }
</style>
<script>
    (function(){
        var box=document.querySelector('[data-evdetail]'), dimg=box&&box.querySelector('[data-evimg]');
        if(!box || !dimg) return;
        var classify=function(){
            var w=dimg.naturalWidth,h=dimg.naturalHeight;
            box.classList.remove('is-landscape','is-portrait','is-square','is-small');
            if(!w||!h){ box.classList.add('is-landscape'); return; }
            box.style.setProperty('--evnatw', w+'px');
            var r=w/h;
            box.classList.add(w<500 ? 'is-small' : (r>=1.25 ? 'is-landscape' : (r<=0.8 ? 'is-portrait' : 'is-square')));
        };
        if(dimg.complete && dimg.naturalWidth){ classify(); }
        else { dimg.addEventListener('load', classify); dimg.addEventListener('error', function(){ box.classList.add('is-landscape'); }); }
    })();
</script>
