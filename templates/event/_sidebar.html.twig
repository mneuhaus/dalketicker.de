{# Left filter sidebar (desktop): search + category checkboxes + place + period.
   Submits via GET to the current route; auto-submits on change (filter_form.js). #}
<form method="get" action="{{ app.request.pathInfo }}" data-autosubmit class="space-y-6">
    {# Search #}
    <div>
        <label for="sidebar-q" class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Suche</label>
        <div class="relative">
            <input type="search" id="sidebar-q" name="q" value="{{ filter.q }}" placeholder="Titel, Ort, Stichwort…"
                   class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 pl-9 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none">
            <svg class="w-4 h-4 absolute left-3 top-3 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
        </div>
    </div>

    {# Categories as coloured toggle buttons: outline when off, filled when on. #}
    <div role="group" aria-labelledby="sidebar-kategorien">
        <div class="flex items-center justify-between mb-2">
            <span id="sidebar-kategorien" class="text-xs font-semibold uppercase tracking-wide text-ink/40">Kategorien</span>
            {% if filter.categorySlugs is not empty %}
                {# Reset only the category selection; keep every other filter. #}
                {% set categoryReset = filter.toQueryParams|filter((v, k) => k != 'kategorie') %}
                <a href="{{ app.request.pathInfo }}{{ categoryReset ? '?' ~ categoryReset|url_encode : '' }}" class="text-xs text-brand-700 hover:underline">alle</a>
            {% endif %}
        </div>
        <div class="flex flex-wrap gap-1.5">
            {% for category in allCategories %}
                {% set active = filter.hasCategory(category.slug) %}
                <label class="cursor-pointer inline-flex items-center rounded-full border px-2.5 py-1 text-sm font-medium transition"
                       style="border-color: {{ category.color }}; {{ active ? 'background-color:' ~ category.color ~ ';color:#fff' : 'color:var(--color-ink)' }}">
                    <input type="checkbox" name="kategorie[]" value="{{ category.slug }}" {{ active ? 'checked' }} class="sr-only">
                    {{ category.name }}
                </label>
            {% endfor %}
        </div>
    </div>

    {# Courses — secondary classification toggle (only / hide). #}
    <fieldset>
        <legend class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Kurse</legend>
        <div class="flex flex-wrap gap-2">
            <label class="cursor-pointer {{ filter.course == 'only' ? 'chip-active' : 'chip-muted' }}">
                <input type="radio" name="kurse" value="only" {{ filter.course == 'only' ? 'checked' }} class="sr-only">Nur Kurse
            </label>
            <label class="cursor-pointer {{ filter.course == 'hide' ? 'chip-active' : 'chip-muted' }}">
                <input type="radio" name="kurse" value="hide" {{ filter.course == 'hide' ? 'checked' }} class="sr-only">Kurse ausblenden
            </label>
        </div>
    </fieldset>

    {# Place — single-select tag bubbles #}
    {% if allCities is not empty %}
        <fieldset>
            <legend class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Ort</legend>
            <div class="flex flex-wrap gap-2">
                <label class="cursor-pointer {{ filter.city is null ? 'chip-active' : 'chip-muted' }}">
                    <input type="radio" name="ort" value="" {{ filter.city is null ? 'checked' }} class="sr-only">{{ current_region.areaName }}
                </label>
                {% for city in allCities %}
                    <label class="cursor-pointer {{ filter.city == city ? 'chip-active' : 'chip-muted' }}">
                        <input type="radio" name="ort" value="{{ city }}" {{ filter.city == city ? 'checked' }} class="sr-only">{{ city }}
                    </label>
                {% endfor %}
            </div>
        </fieldset>
    {% endif %}

    {# Period — quick presets + an optional custom date range (list view only). #}
    {% if view|default('list') == 'list' %}
        <fieldset>
            <legend class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Zeitraum</legend>
            <div class="flex flex-wrap gap-2">
                {% for key, label in constant('App\\Search\\EventFilter::PERIODS') %}
                    {% set active = filter.period == key %}
                    <label class="cursor-pointer {{ active ? 'chip-active' : 'chip-muted' }}">
                        <input type="radio" name="zeitraum" value="{{ key }}" {{ active ? 'checked' }} class="sr-only">
                        {{ label }}
                    </label>
                {% endfor %}
                <button type="button" data-date-toggle class="{{ filter.hasCustomDate ? 'chip-active' : 'chip-muted' }}">Datum…</button>
            </div>
            <div data-date-panel class="{{ filter.hasCustomDate ? '' : 'hidden' }} mt-2 grid grid-cols-2 gap-2">
                <input type="date" name="von" value="{{ filter.hasCustomDate and filter.from ? filter.from|date('Y-m-d') }}" aria-label="von"
                       class="rounded-xl border border-black/10 bg-white px-2.5 py-2 text-sm focus:border-brand-500 outline-none">
                <input type="date" name="bis" value="{{ filter.hasCustomDate and filter.to ? filter.to|date('Y-m-d') }}" aria-label="bis"
                       class="rounded-xl border border-black/10 bg-white px-2.5 py-2 text-sm focus:border-brand-500 outline-none">
            </div>
        </fieldset>
    {% endif %}

    {# "Meine Events" lives in the top navbar. Keep its state in hidden fields so
       changing other filters doesn't drop the "nur meine" view. #}
    <input type="hidden" name="meine" value="1" {{ filter.onlySaved ? '' : 'disabled' }}>
    <input type="hidden" name="ids" data-saved-ids-input value="{{ filter.savedIds|join(',') }}" {{ filter.onlySaved ? '' : 'disabled' }}>

    {% if filter.hasAny %}
        <div>
            <a href="{{ app.request.pathInfo }}" data-reset-filters class="text-sm text-ink/50 hover:text-brand-700">Filter zurücksetzen</a>
        </div>
    {% endif %}

    {# Subscribe to the current (filtered) selection in your own calendar app. #}
    {% set feedUrl = url('event_feed', filter.toQueryParams)|replace({'https://': 'webcal://', 'http://': 'webcal://'}) %}
    <div class="pt-4 border-t border-black/5">
        <a href="{{ feedUrl }}" class="inline-flex items-center gap-1.5 text-sm text-ink/50 hover:text-brand-700 transition"
           title="{{ filter.hasAny ? 'Diese Auswahl' : 'Alle Veranstaltungen' }} im eigenen Kalender abonnieren – aktualisiert sich automatisch">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Kalender abonnieren{% if filter.hasAny %} (gefiltert){% endif %}
        </a>
    </div>
</form>
