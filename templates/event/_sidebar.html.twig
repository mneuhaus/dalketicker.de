{# Left filter sidebar: search + category checkboxes + place + period.
   Submits via GET to the current route; auto-submits on change. #}
<form method="get" action="{{ app.request.pathInfo }}" data-autosubmit class="space-y-6">
    {# "Meine Events" — show only what was bookmarked (client-side, localStorage). #}
    <div>
        <label class="flex items-center justify-between gap-2 rounded-xl border px-3 py-2.5 cursor-pointer transition {{ filter.onlySaved ? 'border-brand-400 bg-brand-50' : 'border-black/10 bg-white hover:border-brand-300' }}">
            <span class="flex items-center gap-2 text-sm font-medium text-ink">
                <svg class="w-4 h-4 text-brand-600" fill="{{ filter.onlySaved ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                Nur meine Events
            </span>
            <span class="flex items-center gap-2">
                <span data-save-count class="hidden min-w-5 h-5 px-1.5 inline-flex items-center justify-center rounded-full bg-brand-100 text-brand-800 text-xs font-semibold">0</span>
                <input type="checkbox" name="meine" value="1" data-meine {{ filter.onlySaved ? 'checked' }} class="w-4 h-4 accent-brand-600">
            </span>
        </label>
        <input type="hidden" name="ids" data-saved-ids-input value="{{ filter.savedIds|join(',') }}" {{ filter.onlySaved ? '' : 'disabled' }}>
    </div>

    {# Search #}
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Suche</label>
        <div class="relative">
            <input type="search" name="q" value="{{ filter.q }}" placeholder="Titel, Ort, Stichwort…"
                   class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 pl-9 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none">
            <svg class="w-4 h-4 absolute left-3 top-3 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
        </div>
    </div>

    {# Categories as checkboxes — uncheck to hide what you don't care about. #}
    <div>
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wide text-ink/40">Kategorien</span>
            {% if filter.categorySlugs is not empty %}
                <a href="{{ app.request.pathInfo }}{{ filter.q ? '?q=' ~ filter.q : '' }}" class="text-xs text-brand-700 hover:underline">alle</a>
            {% endif %}
        </div>
        <ul class="space-y-1">
            {% for category in allCategories %}
                {% set active = filter.hasCategory(category.slug) %}
                <li>
                    <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-black/5 transition {{ active ? 'bg-black/5' : '' }}">
                        <input type="checkbox" name="kategorie[]" value="{{ category.slug }}" {{ active ? 'checked' }}
                               class="peer sr-only">
                        <span class="w-4 h-4 rounded border-2 flex items-center justify-center shrink-0 transition"
                              style="border-color: {{ category.color }}; background-color: {{ active ? category.color : 'transparent' }}">
                            <svg class="w-3 h-3 text-white {{ active ? '' : 'hidden' }}" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="text-sm text-ink/80">{{ category.name }}</span>
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>

    {# Place — single-select tag bubbles #}
    {% if allCities is not empty %}
        <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Ort</label>
            <div class="flex flex-wrap gap-2">
                <label class="cursor-pointer {{ filter.city is null ? 'chip-active' : 'chip-muted' }}">
                    <input type="radio" name="ort" value="" {{ filter.city is null ? 'checked' }} class="sr-only">Alle
                </label>
                {% for city in allCities %}
                    <label class="cursor-pointer {{ filter.city == city ? 'chip-active' : 'chip-muted' }}">
                        <input type="radio" name="ort" value="{{ city }}" {{ filter.city == city ? 'checked' }} class="sr-only">{{ city }}
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Period — quick presets + an optional custom date range (list view only). #}
    {% if view|default('list') == 'list' %}
        <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Zeitraum</label>
            <div class="flex flex-wrap gap-2">
                {% for key, label in constant('App\\Search\\EventFilter::PERIODS') %}
                    {% set active = filter.period == key %}
                    <label class="cursor-pointer {{ active ? 'chip-active' : 'chip-muted' }}">
                        <input type="radio" name="zeitraum" value="{{ key }}" {{ active ? 'checked' }} class="sr-only">
                        {{ label }}
                    </label>
                {% endfor %}
                <button type="button" data-date-toggle class="{{ filter.hasCustomDate ? 'chip-active' : 'chip-muted' }}">Datum…</button>
            </div>
            <div data-date-panel class="{{ filter.hasCustomDate ? '' : 'hidden' }} mt-2 grid grid-cols-2 gap-2">
                <input type="date" name="von" value="{{ filter.hasCustomDate and filter.from ? filter.from|date('Y-m-d') }}" aria-label="von"
                       class="rounded-xl border border-black/10 bg-white px-2.5 py-2 text-sm focus:border-brand-500 outline-none">
                <input type="date" name="bis" value="{{ filter.hasCustomDate and filter.to ? filter.to|date('Y-m-d') }}" aria-label="bis"
                       class="rounded-xl border border-black/10 bg-white px-2.5 py-2 text-sm focus:border-brand-500 outline-none">
            </div>
        </div>
    {% endif %}

    {% if filter.hasAny %}
        <div>
            <a href="{{ app.request.pathInfo }}" class="text-sm text-ink/50 hover:text-brand-700">Filter zurücksetzen</a>
        </div>
    {% endif %}
</form>

<script>
    (function () {
        var form = document.querySelector('form[data-autosubmit]');
        if (!form) return;
        form.addEventListener('change', function (e) {
            // The "meine" toggle is handled in saved_events.js (needs to sync IDs first).
            if (e.target.matches('[data-meine]')) return;
            // Custom date: clear the preset radios so they don't conflict.
            if (e.target.matches('input[type=date]')) {
                if (e.target.value) {
                    form.querySelectorAll('input[name="zeitraum"]').forEach(function (r) { r.checked = false; });
                }
                form.requestSubmit();
                return;
            }
            // Picking a preset clears any custom date.
            if (e.target.matches('input[name="zeitraum"]')) {
                form.querySelectorAll('input[type=date]').forEach(function (d) { d.value = ''; });
            }
            if (e.target.matches('input[type=checkbox], input[type=radio], select')) {
                form.requestSubmit();
            }
        });

        // Toggle the custom date panel.
        var dateToggle = form.querySelector('[data-date-toggle]');
        var datePanel = form.querySelector('[data-date-panel]');
        if (dateToggle && datePanel) {
            dateToggle.addEventListener('click', function () {
                datePanel.classList.toggle('hidden');
            });
        }
    })();
</script>
