{% extends 'base.html.twig' %}

{% block title %}Überrasch mich – {{ site_name }}{% endblock %}
{% block meta_description %}Keine Idee? Lass dir zufällig eine Veranstaltung für heute im Kreis Gütersloh vorschlagen.{% endblock %}

{% block body %}
    <div class="max-w-md md:max-w-2xl mx-auto">
        {% if events is empty %}
            <div class="text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                <p class="font-medium text-ink/70">Heute ist (noch) nichts eingetragen.</p>
                <a href="{{ path('event_index') }}" class="text-brand-700 hover:underline text-sm mt-2 inline-block">Schau in die Liste →</a>
            </div>
        {% else %}
            <div data-surprise class="relative">
                {% for event in events %}
                    {% set color = event.category ? event.category.color : 'var(--color-brand-600)' %}
                    <article data-surprise-card data-url="{{ path('event_show', {id: event.id, slug: event.slug}) }}"
                             class="surprise-card rounded-2xl border border-black/5 bg-white shadow-sm overflow-hidden">
                        {% if event.imageUrl %}
                            <div class="bg-black/[0.03] flex items-center justify-center">
                                <img data-fitcap src="{{ path('image_proxy', {id: event.id}) }}" alt="" loading="lazy" class="fitcap">
                            </div>
                        {% endif %}
                        <div class="p-5">
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <div class="flex flex-wrap items-center gap-2 min-w-0">
                                    {% for category in event.categories %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold text-white" style="background-color: {{ category.color }}">{{ category.name }}</span>
                                    {% endfor %}
                                    {% if event.isCourse %}<span class="inline-flex items-center rounded-full bg-black/5 px-2.5 py-0.5 text-xs font-semibold text-ink/55">Kurs</span>{% endif %}
                                    {% if event.bookingStatus and event.bookingStatus.showBadge %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {{ event.bookingStatus.badgeClasses }}">{{ event.bookingStatus.label }}</span>
                                    {% endif %}
                                </div>
                                <span class="shrink-0 text-sm font-semibold text-brand-800 whitespace-nowrap">{% if event.allDay %}ganztägig{% else %}{{ event.startsAt|date('H:i') }} Uhr{% endif %}</span>
                            </div>
                            <h2 class="font-[family-name:var(--font-display)] text-xl font-bold text-ink leading-snug">{{ event.title }}</h2>
                            {% if event.displayLocation or event.price %}
                                <div class="mt-2 text-sm">
                                    {% if event.displayLocation %}<p class="text-ink/60">{{ event.displayLocation }}</p>{% endif %}
                                    {% if event.price %}<p class="text-ink/45">{{ event.price }}</p>{% endif %}
                                </div>
                            {% endif %}

                            {# Desktop: full details inline, so no need to open the detail page. #}
                            <div class="hidden md:block mt-3 space-y-3">
                                {% if event.venue and event.venue.fullAddress %}
                                    <p class="text-sm text-ink/55">{{ event.venue.fullAddress }}</p>
                                {% endif %}
                                {% if event.organizer %}
                                    <p class="text-sm text-ink/55">Veranstalter: {{ event.organizer }}</p>
                                {% endif %}
                                {% if event.description %}
                                    <div class="prose prose-sm max-w-none text-ink/80 whitespace-pre-line">{{ event.description|sanitize_html('event_description') }}</div>
                                {% endif %}
                                <div class="flex flex-wrap items-center gap-3 pt-1">
                                    {% if event.sourceUrl matches '#^https?://#' %}
                                        <a href="{{ event.sourceUrl }}" target="_blank" rel="noopener" class="inline-flex items-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition">Zur Veranstaltungsseite ↗</a>
                                    {% endif %}
                                    <button type="button" data-save-btn data-event-id="{{ event.id }}" aria-pressed="false"
                                            class="save-btn inline-flex items-center gap-2 rounded-xl border border-black/10 px-4 py-2 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                                        Merken
                                    </button>
                                </div>
                                <p class="text-xs text-ink/40">Quelle: {{ event.source.name }}</p>
                            </div>
                        </div>
                    </article>
                {% endfor %}

                <div data-surprise-done class="hidden text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                    <p class="font-medium text-ink/70">Mehr ist heute leider nicht los.</p>
                    <button type="button" data-surprise-restart class="text-brand-700 hover:underline text-sm mt-2">Nochmal von vorn</button>
                </div>
            </div>

            {# Hint + counter live below the event. #}
            <p class="text-center text-sm text-ink/50 mt-4">Zufälliger Tipp für heute – passt nicht? Einfach weiter.</p>
            <p data-surprise-counter class="text-center text-xs text-ink/40 mt-1"></p>
        {% endif %}
    </div>

    {% if events is not empty %}
        {# Action bar: a sticky bottom nav on mobile, a normal row on desktop. #}
        <div data-surprise-actions
             class="fixed bottom-0 inset-x-0 z-30 px-4 py-3 bg-paper/95 backdrop-blur border-t border-black/5
                    md:static md:inset-auto md:z-auto md:px-0 md:py-0 md:mt-5 md:bg-transparent md:border-0">
            <div class="max-w-md md:max-w-2xl mx-auto flex items-center gap-2">
                <button type="button" data-surprise-next
                        class="shrink-0 inline-flex items-center gap-1.5 rounded-xl border border-black/10 bg-white px-3 py-2.5 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992V4.356M2.985 19.644v-4.992h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
                    Nee, was anderes
                </button>
                <a data-surprise-go href="{{ path('event_index') }}"
                   class="flex-1 text-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition whitespace-nowrap">Auf geht's →</a>
            </div>
        </div>
    {% endif %}

    {{ include('event/_image_fit.html.twig') }}
{% endblock %}
