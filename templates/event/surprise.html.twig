{% extends 'base.html.twig' %}

{% block title %}Überrasch mich – {{ site_name }}{% endblock %}
{% block meta_description %}Keine Idee? Lass dir zufällig eine Veranstaltung für heute im Kreis Gütersloh vorschlagen.{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto">
        {% if events is empty %}
            <div class="text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                <p class="font-medium text-ink/70">Heute ist (noch) nichts eingetragen.</p>
                <a href="{{ path('event_index') }}" class="text-brand-700 hover:underline text-sm mt-2 inline-block">Schau in die Liste →</a>
            </div>
        {% else %}
            <div data-surprise class="relative">
                {% for event in events %}
                    {% set color = event.category ? event.category.color : 'var(--color-brand-600)' %}
                    <article data-surprise-card data-url="{{ path('event_show', {id: event.id, slug: event.slug}) }}"
                             class="surprise-card rounded-2xl border border-black/5 bg-white shadow-sm overflow-hidden">
                        {% if event.imageUrl %}
                            <div class="relative bg-black/5">
                                <img src="{{ path('image_proxy', {id: event.id}) }}" alt="" loading="lazy" class="w-full h-48 object-cover">
                            </div>
                        {% endif %}
                        <div class="p-5">
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                {% if event.category %}
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold text-white" style="background-color: {{ color }}">{{ event.category.name }}</span>
                                {% endif %}
                                {% if event.isCourse %}<span class="inline-flex items-center rounded-full bg-black/5 px-2.5 py-0.5 text-xs font-semibold text-ink/55">Kurs</span>{% endif %}
                                {% if event.bookingStatus and event.bookingStatus.showBadge %}
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {{ event.bookingStatus.badgeClasses }}">{{ event.bookingStatus.label }}</span>
                                {% endif %}
                            </div>
                            <h2 class="font-[family-name:var(--font-display)] text-xl font-bold text-ink leading-snug">{{ event.title }}</h2>
                            <p class="mt-1.5 text-sm font-semibold text-brand-800">
                                {% if event.allDay %}ganztägig{% else %}{{ event.startsAt|date('H:i') }} Uhr{% endif %}
                            </p>
                            {% if event.displayLocation %}
                                <p class="mt-0.5 text-sm text-ink/60">{{ event.displayLocation }}</p>
                            {% endif %}
                            {% if event.price %}<p class="mt-0.5 text-sm text-ink/45">{{ event.price }}</p>{% endif %}
                        </div>
                    </article>
                {% endfor %}

                <div data-surprise-done class="hidden text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                    <p class="font-medium text-ink/70">Das war alles für heute.</p>
                    <button type="button" data-surprise-restart class="text-brand-700 hover:underline text-sm mt-2">Nochmal von vorn</button>
                </div>
            </div>

            {# Hint + counter live below the event. #}
            <p class="text-center text-sm text-ink/50 mt-4">Zufälliger Tipp für heute – passt nicht? Einfach weiter.</p>
            <p data-surprise-counter class="text-center text-xs text-ink/40 mt-1"></p>
        {% endif %}
    </div>

    {% if events is not empty %}
        {# Action bar: a sticky bottom nav on mobile, a normal row on desktop. #}
        <div data-surprise-actions
             class="sticky bottom-0 z-30 -mx-4 px-4 py-3 bg-paper/95 backdrop-blur border-t border-black/5
                    md:static md:z-auto md:mx-0 md:px-0 md:py-0 md:mt-5 md:bg-transparent md:border-0">
            <div class="max-w-md mx-auto flex items-center gap-2">
                <button type="button" data-surprise-next
                        class="shrink-0 inline-flex items-center gap-1.5 rounded-xl border border-black/10 bg-white px-3 py-2.5 text-sm font-semibold text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992V4.356M2.985 19.644v-4.992h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
                    Nee, was anderes
                </button>
                <a data-surprise-go href="{{ path('event_index') }}"
                   class="flex-1 text-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition whitespace-nowrap">Auf geht's →</a>
            </div>
        </div>
    {% endif %}
{% endblock %}
