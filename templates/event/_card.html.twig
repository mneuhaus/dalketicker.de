{# A single event card. Expects `event`.
   Two shapes: a media card (image front-and-center, full-width banner on top)
   when the event has an image; otherwise a compact row (time column + body).
   The title link stretches over the whole card; the bookmark sits above it. #}
{% set multiDay = event.endsAt and event.endsAt|date('Y-m-d') != event.startsAt|date('Y-m-d') %}
{% set showUrl = path('event_show', {id: event.id, slug: event.slug}|merge(filter.toQueryParams|default({}))) %}
{% set soldOut = event.bookingStatus and event.bookingStatus.isSoldOut %}

{# Status pills shown next to the time: categories + course + booking state. #}
{% macro tags(event) %}
    {% for category in event.categories %}
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold text-white whitespace-nowrap" style="background-color: {{ category.color }}">{{ category.name }}</span>
    {% endfor %}
    {% if event.isCourse %}
        <span class="inline-flex items-center rounded-full bg-black/5 px-2 py-0.5 text-xs font-semibold text-ink/55 whitespace-nowrap">Kurs</span>
    {% endif %}
    {% if event.bookingStatus and event.bookingStatus.showBadge %}
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold whitespace-nowrap {{ event.bookingStatus.badgeClasses }}">{{ event.bookingStatus.label }}</span>
    {% endif %}
{% endmacro %}

{# Location (+ price), pinned to the bottom-left of the card. #}
{% macro place(event) %}
    {% if event.displayLocation or event.price %}
        <div class="mt-auto pt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink/55">
            {% if event.displayLocation %}
                <span class="inline-flex items-center gap-1 min-w-0 max-w-full">
                    <svg class="w-3.5 h-3.5 shrink-0 text-ink/35" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span class="truncate">{{ event.displayLocation }}</span>
                </span>
            {% endif %}
            {% if event.price %}<span class="text-ink/25">·</span><span class="whitespace-nowrap">{{ event.price }}</span>{% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% import _self as card %}

{% set bookmark %}
    <button type="button" data-save-btn data-event-id="{{ event.id }}" aria-pressed="false"
            class="save-btn absolute top-2.5 right-2.5 z-20 rounded-md bg-white/75 backdrop-blur-sm p-1 text-ink/40 hover:text-brand-600 transition"
            aria-label="Merken" title="Merken">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
    </button>
{% endset %}

{% set titleLink %}
    <h3 class="font-[family-name:var(--font-display)] text-base sm:text-lg font-bold text-ink leading-snug line-clamp-2 group-hover:text-brand-700 transition">
        <a href="{{ showUrl }}" class="before:absolute before:inset-0 before:z-0">{{ event.title }}</a>
    </h3>
{% endset %}

{# One unified card. The image (when present) sits right of the text and
   breathes to its own aspect (capped, never upscaled); the time is a blue
   line directly under the title, the same on every card. #}
{# Recurring series (passed as `series`) collapse to one card with a run label
   instead of a single time; the concrete time is kept only when meaningful. #}
{% set hasClock = not event.allDay and event.startsAt|date('H:i') != '00:00' %}
{% set timeText %}
    {%- if series -%}
        {% if hasClock %}{{ event.startsAt|date('H:i') }} Uhr · {% endif %}{{ series.daily ? 'täglich' : series.count ~ ' Termine' }} bis {{ series.last|de_date }}
    {%- elseif event.allDay -%}
        ganztägig
    {%- else -%}
        {{ event.startsAt|date('H:i') }} Uhr
    {%- endif -%}
    {%- if not series and multiDay %} · bis {{ event.endsAt|de_date }}{% endif -%}
{% endset %}
<article data-event-card="{{ event.id }}" class="card-media group relative rounded-2xl border border-black/5 bg-white shadow-sm overflow-hidden transition hover:shadow-md hover:border-black/10 {{ soldOut ? 'opacity-60' }}">
    {% if event.imageUrl %}
        <div class="cm-img">
            <img src="{{ path('image_proxy', {id: event.id}) }}" alt="" loading="lazy" class="cm-img-el">
        </div>
    {% endif %}
    {{ bookmark }}
    <div class="cm-body p-4 {{ event.imageUrl ? '' : 'pr-9' }}">
        {{ titleLink }}
        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1.5">
            <span class="text-sm font-semibold text-brand-700 whitespace-nowrap">{{ timeText }}</span>
            {{ card.tags(event) }}
        </div>
        {# Fill the whitespace next to a tall image with the start of the
           description — clipped to whatever space is left (faded out), so the
           card never grows beyond the image height. #}
        {% if event.imageUrl and event.description %}
            <p class="cm-desc mt-2 text-[13px] leading-snug text-ink/55">{{ event.description|striptags }}</p>
        {% endif %}
        {{ card.place(event) }}
    </div>
</article>
