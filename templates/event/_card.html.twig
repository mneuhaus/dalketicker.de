{# A single event row/card. Expects `event`.
   Uses the "stretched link" pattern: the title link covers the whole card via
   a ::before overlay, so the bookmark button (higher z-index) stays clickable. #}
<div data-event-card="{{ event.id }}" class="group relative flex gap-4 rounded-2xl border border-black/5 bg-white p-4 shadow-sm hover:shadow-md hover:border-brand-200 transition">

    {# Merken (bookmark) — toggled client-side, see assets/app.js #}
    <button type="button" data-save-btn data-event-id="{{ event.id }}" aria-pressed="false"
            class="save-btn absolute top-3 right-3 z-20 text-ink/30 hover:text-brand-600 transition"
            aria-label="Merken" title="Merken">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
    </button>

    {# Time block #}
    {% set multiDay = event.endsAt and event.endsAt|date('Y-m-d') != event.startsAt|date('Y-m-d') %}
    <div class="shrink-0 w-16 text-center">
        {% if event.allDay %}
            <div class="text-xs font-semibold text-brand-700 uppercase tracking-wide mt-1">ganztags</div>
        {% else %}
            <div class="text-2xl font-[family-name:var(--font-display)] font-extrabold text-ink leading-none">{{ event.startsAt|date('H:i') }}</div>
            <div class="text-xs text-ink/40 mt-1">Uhr</div>
        {% endif %}
        {% if multiDay %}
            <div class="text-[11px] text-ink/40 mt-1">bis {{ event.endsAt|de_date }}</div>
        {% elseif event.endsAt and not event.allDay %}
            <div class="text-[11px] text-ink/40 mt-1">bis {{ event.endsAt|date('H:i') }}</div>
        {% endif %}
    </div>

    {% if event.imageUrl %}
        <div class="hidden sm:block shrink-0 w-24 h-24 rounded-xl overflow-hidden bg-black/5">
            <img src="{{ event.imageUrl }}" alt="" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition">
        </div>
    {% endif %}

    {# Body #}
    <div class="min-w-0 flex-1 pr-7">
        {% if event.category %}
            <span class="chip text-white text-xs" style="background-color: {{ event.category.color }}">{{ event.category.name }}</span>
        {% endif %}
        <h3 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink leading-snug mt-1 group-hover:text-brand-700 transition line-clamp-2">
            <a href="{{ path('event_show', {id: event.id, slug: event.slug}) }}" class="before:absolute before:inset-0 before:z-0">{{ event.title }}</a>
        </h3>
        {% if event.displayLocation %}
            <p class="text-sm text-ink/60 mt-1 flex items-center gap-1.5">
                <svg class="w-4 h-4 shrink-0 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {{ event.displayLocation }}
            </p>
        {% endif %}
        <div class="flex items-center gap-2 mt-2 text-xs text-ink/40">
            <span>via {{ event.source.name }}</span>
            {% if event.price %}<span>·</span><span class="text-ink/60">{{ event.price }}</span>{% endif %}
        </div>
    </div>
</div>
