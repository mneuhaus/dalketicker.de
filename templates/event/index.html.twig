{% extends 'layout_with_sidebar.html.twig' %}

{# Let calendar apps auto-discover the (full) subscribable feed. #}
{% block head_links %}
    <link rel="alternate" type="text/calendar" title="dalketicker – Veranstaltungen Kreis Gütersloh" href="{{ url('event_feed') }}">
{% endblock %}

{% block content %}
    {% if groups is not empty %}
        {# Subscribe to exactly the current filter selection (webcal:// opens the
           "add calendar" dialog in most apps; the feed ignores the time range). #}
        {% set feedUrl = url('event_feed', filter.toQueryParams)|replace({'https://': 'webcal://', 'http://': 'webcal://'}) %}
        <div class="flex justify-end -mt-1 mb-4">
            <a href="{{ feedUrl }}"
               class="inline-flex items-center gap-1.5 rounded-lg border border-black/10 px-3 py-1.5 text-sm font-medium text-ink/60 hover:border-brand-300 hover:text-brand-700 transition"
               title="{{ filter.hasAny ? 'Diese gefilterte Auswahl' : 'Alle Veranstaltungen' }} im eigenen Kalender abonnieren – aktualisiert sich automatisch">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Kalender abonnieren{% if filter.hasAny %} <span class="text-ink/40">(gefiltert)</span>{% endif %}
            </a>
        </div>
    {% endif %}

    {% if groups is empty %}
        {% if filter.onlySaved %}
            <div class="text-center py-16 px-6 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                <svg class="w-10 h-10 mx-auto text-brand-500/70" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                <p class="font-medium text-ink/70 mt-3">Noch keine Events gemerkt</p>
                <p class="text-sm mt-1 max-w-sm mx-auto leading-relaxed">
                    Tippe bei einer Veranstaltung oben rechts auf das
                    <svg class="inline-block w-4 h-4 -mt-0.5 text-ink/45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    Lesezeichen, um sie hier zu sammeln.
                </p>
                <a href="{{ path('event_index') }}" class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-brand-700 hover:underline">Veranstaltungen entdecken →</a>
            </div>
        {% else %}
            <div class="text-center py-20 text-ink/50 border border-dashed border-black/10 rounded-2xl">
                <p class="font-medium text-ink/70">Nichts gefunden.</p>
                <p class="text-sm mt-1">Pass die Filter an oder schau in den <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="text-brand-700 underline">Kalender</a>.</p>
            </div>
        {% endif %}
    {% else %}
        {{ include('event/_grouped_list.html.twig') }}

        {% if pages > 1 %}
            <nav class="flex justify-center items-center gap-2 mt-10">
                {% if page > 1 %}
                    <a href="{{ path('event_index', filter.toQueryParams|merge({seite: page - 1})) }}" class="chip-muted">← Zurück</a>
                {% endif %}
                <span class="text-sm text-ink/50">Seite {{ page }} / {{ pages }}</span>
                {% if page < pages %}
                    <a href="{{ path('event_index', filter.toQueryParams|merge({seite: page + 1})) }}" class="chip-muted">Weiter →</a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}

    {{ include('event/_image_fit.html.twig') }}
{% endblock %}
