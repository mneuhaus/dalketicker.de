{% extends 'base.html.twig' %}

{% block title %}Fehler – {{ site_name }}{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto py-16 text-center">
        <p class="font-[family-name:var(--font-display)] text-6xl font-extrabold tracking-tight text-brand-600">{{ status_code|default(500) }}</p>
        <h1 class="mt-3 font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight text-ink">Es ist ein Fehler aufgetreten</h1>
        <p class="mt-3 text-ink/60 leading-relaxed">Das hat leider nicht geklappt. Bitte versuch es gleich noch einmal.</p>
        {# Static link on purpose: must work even if the router misbehaves. #}
        <a href="/" class="mt-6 inline-flex items-center rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition">Zur Startseite</a>
    </div>
{% endblock %}
