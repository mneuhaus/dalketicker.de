{% extends 'base.html.twig' %}

{# Mobile/narrow: the dropdown filter bar sticks to the top together with the header. #}
{% block subheader %}{{ include('event/_filter_bar.html.twig') }}{% endblock %}

{% block body %}
    <div class="md:grid md:grid-cols-[16rem_minmax(0,1fr)] md:gap-6 md:items-start">
        {# Desktop: the chip sidebar — sticky and independently scrollable so it
           never gets cut off on a short viewport. #}
        <aside class="hidden md:block md:sticky md:top-20 md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:pr-1 mb-6 md:mb-0">
            {{ include('event/_sidebar.html.twig') }}
        </aside>

        <div class="min-w-0">
            {% block content %}{% endblock %}
        </div>
    </div>
{% endblock %}
