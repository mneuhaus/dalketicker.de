{% extends 'base.html.twig' %}

{% block title %}Lauf #{{ run.id }} – {{ run.source.name }} – {{ site_name }}{% endblock %}

{% macro badge(status) %}
    {% set map = {'ok': 'bg-emerald-100 text-emerald-800', 'partial': 'bg-amber-100 text-amber-800', 'failed': 'bg-rose-100 text-rose-700'} %}
    {% set label = {'ok': 'OK', 'partial': 'Teilweise', 'failed': 'Fehler'} %}
    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ map[status] ?? 'bg-black/10 text-ink/60' }}">{{ label[status] ?? status }}</span>
{% endmacro %}

{% block body %}
    {% import _self as ui %}
    <a href="{{ path('admin_imports') }}" class="text-sm text-ink/50 hover:text-brand-700 inline-flex items-center gap-1 mb-4">← Monitoring</a>

    <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-1">
            <h1 class="font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight text-ink">
                <a href="{{ path('admin_source', {id: run.source.id}) }}" class="hover:text-brand-700 hover:underline">{{ run.source.name }}</a>
            </h1>
            {{ ui.badge(run.status) }}
        </div>
        <p class="text-ink/50 text-sm mb-6">{{ run.source.key }} · Importer „{{ run.source.importer }}" · Lauf #{{ run.id }}{% if run.dryRun %} · Testlauf{% endif %}</p>

        <div class="grid sm:grid-cols-2 gap-4 mb-6">
            <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-3">Zeitpunkt</h2>
                <dl class="space-y-1.5 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Start</dt><dd class="text-ink font-medium">{{ run.startedAt|de_date(true) }}, {{ run.startedAt|date('H:i:s') }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Ende</dt><dd class="text-ink font-medium">{{ run.finishedAt ? run.finishedAt|date('H:i:s') : '–' }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Dauer</dt><dd class="text-ink font-medium">{{ (run.durationMs / 1000)|round(2) }} s</dd></div>
                </dl>
            </div>
            <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-3">Ergebnis</h2>
                <dl class="space-y-1.5 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Gesehen</dt><dd class="text-ink font-medium tabular-nums">{{ run.seen }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Neu</dt><dd class="text-ink font-medium tabular-nums">{{ run.created }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Aktualisiert</dt><dd class="text-ink font-medium tabular-nums">{{ run.updated }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Unverändert</dt><dd class="text-ink font-medium tabular-nums">{{ run.unchanged }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Duplikate</dt><dd class="text-ink font-medium tabular-nums">{{ run.duplicates }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-ink/50">Fehler</dt><dd class="font-medium tabular-nums {{ run.errors > 0 ? 'text-rose-600' : 'text-ink' }}">{{ run.errors }}</dd></div>
                </dl>
            </div>
        </div>

        {% if run.message %}
            <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5 mb-6">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-2">Meldung</h2>
                <pre class="text-xs text-ink/70 whitespace-pre-wrap break-words font-mono">{{ run.message }}</pre>
            </div>
        {% endif %}

        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink mb-3">Verlauf dieser Quelle</h2>
        <div class="bg-white rounded-2xl border border-black/5 shadow-sm divide-y divide-black/5">
            {% for h in history %}
                <a href="{{ path('admin_import_run', {id: h.id}) }}" class="flex items-center gap-4 px-4 py-2.5 text-sm hover:bg-black/[0.02] {{ h.id == run.id ? 'bg-brand-50/60' : '' }}">
                    <span class="text-ink/40 text-xs w-28 shrink-0">{{ h.startedAt|de_date }} {{ h.startedAt|date('H:i') }}</span>
                    {{ ui.badge(h.status) }}
                    <span class="text-ink/50 tabular-nums flex-1 text-right">{{ h.seen }} ges. · {{ h.created }} neu · {{ h.errors }} Fehler</span>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
