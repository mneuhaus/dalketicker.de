{% extends 'base.html.twig' %}

{% block title %}Event bearbeiten – {{ site_name }}{% endblock %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% macro field(event, name, label, value, multiline) %}
    <div>
        <div class="flex items-center justify-between mb-1">
            <label class="block text-xs font-semibold uppercase tracking-wide text-ink/40">{{ label }}</label>
            <label class="inline-flex items-center gap-1.5 text-xs text-ink/55 cursor-pointer select-none">
                <input type="checkbox" name="lock_{{ name }}" {{ event.isFieldLocked(name) ? 'checked' }}
                       class="rounded border-black/20 text-brand-600 focus:ring-brand-200">
                gepinnt (nicht aus Quelle aktualisieren)
            </label>
        </div>
        {% if multiline %}
            <textarea name="{{ name }}" rows="6" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none">{{ value }}</textarea>
        {% else %}
            <input type="text" name="{{ name }}" value="{{ value }}" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none">
        {% endif %}
    </div>
{% endmacro %}

{% block body %}
    {% import _self as f %}
    <a href="{{ path('admin_source', {id: event.source.id}) }}" class="text-sm text-ink/50 hover:text-brand-700 inline-flex items-center gap-1 mb-4">← {{ event.source.name }}</a>

    <div class="max-w-2xl">
        <h1 class="font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight text-ink mb-1">Event bearbeiten</h1>
        <p class="text-sm text-ink/50 mb-6">Korrigierte Felder als <strong class="text-ink/70">gepinnt</strong> markieren — sie bleiben dann beim nächsten Import erhalten. Nicht gepinnte Felder werden weiter aus der Quelle aktualisiert.</p>

        {% for msg in app.flashes('success') %}<div class="rounded-xl bg-emerald-50 text-emerald-800 text-sm px-4 py-3 mb-4">{{ msg }}</div>{% endfor %}
        {% for msg in app.flashes('error') %}<div class="rounded-xl bg-rose-50 text-rose-700 text-sm px-4 py-3 mb-4">{{ msg }}</div>{% endfor %}

        <form method="post" action="{{ path('admin_event_update', {id: event.id}) }}" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('event_edit') }}">
            {{ f.field(event, 'title', 'Titel', event.title, false) }}
            {{ f.field(event, 'organizer', 'Veranstalter', event.organizer, false) }}
            {{ f.field(event, 'description', 'Beschreibung', event.description, true) }}
            {{ f.field(event, 'imageUrl', 'Bild-URL', event.imageUrl, false) }}

            {% if event.imageUrl %}
                <div>
                    <span class="block text-xs font-semibold uppercase tracking-wide text-ink/40 mb-1">Bild-Vorschau</span>
                    <img src="{{ path('image_proxy', {id: event.id}) }}" alt="" class="max-h-48 rounded-xl border border-black/5">
                </div>
            {% endif %}

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition">Speichern</button>
                <a href="{{ path('event_show', {id: event.id, slug: event.slug}) }}" target="_blank" class="text-sm text-ink/50 hover:text-brand-700">Event ansehen ↗</a>
            </div>
        </form>
    </div>
{% endblock %}
