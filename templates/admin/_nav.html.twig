{# Consistent admin sub-navigation, rendered in base.html.twig's `subheader`
   block (sticky, directly under the main header) on every admin page. The
   active section is highlighted by the current route. #}
{% set route = app.request.attributes.get('_route') %}
{% set unread = unread_contacts() %}
{% set aiActive = route in ['admin_dedup', 'admin_categorize', 'admin_summaries'] %}
{% set regionFilterRoutes = ['admin_imports', 'admin_stats', 'admin_dedup', 'admin_categorize', 'admin_summaries'] %}
{% set adminRegionKey = admin_region_key|default(app.request.query.get('region') ?: current_region.key) %}
<div class="border-b border-black/5 bg-paper/95 backdrop-blur">
    <div class="mx-auto max-w-6xl px-4 py-2 flex flex-wrap items-center gap-1.5 text-sm">
        <span class="mr-auto inline-flex items-center gap-1.5 text-ink/40 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> Admin
        </span>
        {% if route in regionFilterRoutes %}
            <form method="get" action="{{ path(route) }}" class="order-last basis-full sm:order-none sm:basis-auto sm:mr-2">
                <label class="sr-only" for="admin-region-filter">Region</label>
                <select id="admin-region-filter" name="region" onchange="this.form.submit()"
                        class="h-8 w-full sm:w-auto rounded-lg border border-black/10 bg-white px-2.5 pr-7 text-xs font-medium text-ink/70 shadow-sm outline-none hover:border-brand-300 focus:border-brand-500">
                    <option value="all" {{ adminRegionKey == 'all' ? 'selected' }}>Alle Regionen</option>
                    {% for region in all_regions %}
                        <option value="{{ region.key }}" {{ adminRegionKey == region.key ? 'selected' }}>{{ region.siteName }}</option>
                    {% endfor %}
                </select>
            </form>
        {% endif %}
        <a href="{{ path('admin_imports', admin_region_params()) }}"
           class="px-2.5 py-1 rounded-lg transition {{ route in ['admin_imports','admin_import_run','admin_source'] ? 'bg-brand-600 text-white' : 'text-ink/60 hover:bg-black/5' }}">Quellen</a>

        {# AI-Werkzeuge gebündelt #}
        <details class="relative">
            <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg transition {{ aiActive ? 'bg-brand-600 text-white' : 'text-ink/60 hover:bg-black/5' }}">
                AI
                <svg class="w-3.5 h-3.5 shrink-0 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="absolute left-0 mt-1.5 w-44 rounded-xl border border-black/5 bg-white shadow-lg py-1 z-50">
                <a href="{{ path('admin_dedup', admin_region_params()) }}" class="block px-3 py-2 text-sm hover:bg-black/5 {{ route == 'admin_dedup' ? 'font-semibold text-brand-700' : 'text-ink/70' }}">Deduplizierung</a>
                <a href="{{ path('admin_categorize', admin_region_params()) }}" class="block px-3 py-2 text-sm hover:bg-black/5 {{ route == 'admin_categorize' ? 'font-semibold text-brand-700' : 'text-ink/70' }}">Kategorien</a>
                <a href="{{ path('admin_summaries', admin_region_params()) }}" class="block px-3 py-2 text-sm hover:bg-black/5 {{ route == 'admin_summaries' ? 'font-semibold text-brand-700' : 'text-ink/70' }}">Vorschau</a>
            </div>
        </details>

        <a href="{{ path('admin_stats', admin_region_params()) }}"
           class="px-2.5 py-1 rounded-lg transition {{ route == 'admin_stats' ? 'bg-brand-600 text-white' : 'text-ink/60 hover:bg-black/5' }}">Statistik</a>
        <a href="{{ path('admin_contact') }}"
           class="px-2.5 py-1 rounded-lg transition inline-flex items-center gap-1.5 {{ route == 'admin_contact' ? 'bg-brand-600 text-white' : 'text-ink/60 hover:bg-black/5' }}">
            Kontakt
            {% if unread > 0 %}<span class="min-w-4 h-4 px-1 inline-flex items-center justify-center rounded-full bg-rose-500 text-white text-[10px] font-bold">{{ unread }}</span>{% endif %}
        </a>
        <span class="hidden sm:inline text-ink/15" aria-hidden="true">|</span>
        {% if app.user %}
            {# User-Menü: E-Mail als Dropdown-Trigger, Konto + Logout darin (<details>, kein JS). #}
            <details class="relative ml-0.5">
                <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg transition {{ route == 'admin_account' ? 'bg-brand-600 text-white' : 'text-ink/60 hover:bg-black/5' }}">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <span class="hidden sm:inline max-w-[12rem] truncate">{{ app.user.email }}</span>
                    <svg class="w-3.5 h-3.5 shrink-0 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="absolute right-0 mt-1.5 w-48 rounded-xl border border-black/5 bg-white shadow-lg py-1 z-50">
                    <div class="px-3 py-1.5 text-xs text-ink/40 truncate border-b border-black/5 sm:hidden">{{ app.user.email }}</div>
                    <a href="{{ path('admin_account') }}" class="block px-3 py-2 text-sm text-ink/70 hover:bg-black/5 {{ route == 'admin_account' ? 'font-semibold text-brand-700' }}">Konto</a>
                    <a href="{{ path('app_logout') }}" class="block px-3 py-2 text-sm text-rose-600 hover:bg-rose-50">Logout</a>
                </div>
            </details>
        {% else %}
            <a href="{{ path('app_logout') }}" class="px-2.5 py-1 rounded-lg text-ink/60 hover:bg-black/5 transition">Logout</a>
        {% endif %}
    </div>
</div>
