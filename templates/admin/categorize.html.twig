{% extends 'base.html.twig' %}

{% block title %}AI-Kategorien – {{ site_name }}{% endblock %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{# While a run is actively writing decisions, refresh so the bar moves live. #}
{% block head_links %}{% if active %}<meta http-equiv="refresh" content="8">{% endif %}{% endblock %}

{% macro slugchips(slugs) %}
    {% for slug in slugs %}
        <span class="inline-flex items-center rounded-full bg-black/5 px-2 py-0.5 text-[11px] font-semibold text-ink/70 whitespace-nowrap">{{ slug }}</span>
    {% else %}
        <span class="text-ink/30 text-xs">—</span>
    {% endfor %}
{% endmacro %}
{% import _self as ui %}

{% block body %}
    <div class="flex items-center justify-between gap-3 mb-6">
        <div>
            <h1 class="font-[family-name:var(--font-display)] text-2xl font-extrabold text-ink">AI-Kategorien</h1>
            <p class="text-sm text-ink/50 mt-0.5">
                Lücken werden automatisch gefüllt; Widersprüche zur Importer-Kategorie landen hier zur Prüfung.
                Modell: {{ model }}{% if not configured %} <span class="text-rose-600 font-semibold">– nicht konfiguriert</span>{% endif %}
            </p>
        </div>
        <form method="post" action="{{ path('admin_categorize_run') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('categorize') }}">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition" {{ configured ? '' : 'disabled' }}>
                Jetzt durchlaufen
            </button>
        </form>
    </div>

    {# Progress: processed events vs. the ones still to look at. #}
    {% set total = processed + remaining %}
    {% set pct = total > 0 ? (processed / total * 100)|round : 100 %}
    <div class="rounded-2xl border border-black/5 bg-white p-4 mb-8">
        <div class="flex items-center justify-between text-sm mb-2">
            <span class="font-semibold text-ink">
                {% if active %}
                    <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Läuft …</span>
                {% elseif remaining == 0 %}
                    Alle Events geprüft
                {% else %}
                    {{ remaining }} Events noch nicht geprüft
                {% endif %}
            </span>
            <span class="text-ink/50">{{ processed }} / {{ total }} ({{ pct }}%)</span>
        </div>
        <div class="h-2 w-full rounded-full bg-black/5 overflow-hidden">
            <div class="h-full rounded-full bg-brand-500 transition-all" style="width: {{ pct }}%"></div>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink/55">
            <span><strong class="text-ink/80">{{ counts.applied }}</strong> gesetzt/überschrieben</span>
            <span><strong class="text-ink/80">{{ counts.agreed }}</strong> bestätigt</span>
            {% if counts.pending %}<span><strong class="text-ink/80">{{ counts.pending }}</strong> offen</span>{% endif %}
            {% if counts.undone %}<span>{{ counts.undone }} rückgängig</span>{% endif %}
        </div>
    </div>

    {# Short-teaser (summary) progress — separate AI pass over own sources. #}
    {% set sTotal = summaryEligible %}
    {% set sPct = sTotal > 0 ? (summaryDone / sTotal * 100)|round : 100 %}
    <div class="rounded-2xl border border-black/5 bg-white p-4 mb-8">
        <div class="flex items-center justify-between text-sm mb-2">
            <span class="font-semibold text-ink">Kurzvorschauen (KI-Teaser)</span>
            <span class="text-ink/50">{{ summaryDone }} / {{ sTotal }} ({{ sPct }}%)</span>
        </div>
        <div class="h-2 w-full rounded-full bg-black/5 overflow-hidden">
            <div class="h-full rounded-full bg-amber-500 transition-all" style="width: {{ sPct }}%"></div>
        </div>
        <p class="mt-2 text-xs text-ink/50">Nur eigene Quellen mit Beschreibung; Fremdquellen sind ausgenommen.</p>
    </div>

    {# Pending suggestions only appear if some still exist (legacy); with
       auto-apply everything is set directly, so this is normally empty. #}
    {% if pending is not empty %}
        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-brand-800 mb-3">
            Offene Vorschläge <span class="text-sm font-normal text-ink/40">({{ pending|length }})</span>
        </h2>
        <div class="space-y-2 mb-10">
            {% for d in pending %}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-black/5 bg-white p-3">
                    <div class="min-w-0 flex-1">
                        <a href="{{ path('event_show', {id: d.event.id, slug: d.event.slug}) }}" target="_blank" rel="noopener" class="text-sm font-semibold text-ink hover:text-brand-700 line-clamp-1">{{ d.event.title }}</a>
                        <div class="text-xs text-ink/45 line-clamp-1">{{ d.event.displayLocation }}</div>
                        {% if d.reason %}<div class="text-xs text-ink/40 mt-0.5 italic line-clamp-1">{{ d.reason }}</div>{% endif %}
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="flex flex-wrap gap-1">{% for c in d.event.categories %}<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold text-white" style="background-color: {{ c.color }}">{{ c.name }}</span>{% endfor %}</span>
                        <span class="text-ink/30">→</span>
                        <span class="flex flex-wrap gap-1">{{ ui.slugchips(d.proposedSlugs) }}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <form method="post" action="{{ path('admin_categorize_decide', {id: d.id, action: 'accept'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('categorize') }}">
                            <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 transition">Übernehmen</button>
                        </form>
                        <form method="post" action="{{ path('admin_categorize_decide', {id: d.id, action: 'dismiss'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('categorize') }}">
                            <button class="rounded-lg border border-black/10 px-3 py-1.5 text-xs font-medium text-ink/60 hover:bg-black/5 transition">Verwerfen</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Recently auto-applied (fills + accepted), with undo #}
    <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-brand-800 mb-3">
        Zuletzt automatisch gesetzt <span class="text-sm font-normal text-ink/40">({{ applied|length }})</span>
    </h2>
    {% if applied is empty %}
        <p class="text-sm text-ink/50">Noch nichts angewendet.</p>
    {% else %}
        <div class="space-y-1.5">
            {% for d in applied %}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 rounded-lg border border-black/5 bg-white px-3 py-2 text-sm">
                    <a href="{{ path('event_show', {id: d.event.id, slug: d.event.slug}) }}" target="_blank" rel="noopener" class="min-w-0 flex-1 font-medium text-ink hover:text-brand-700 line-clamp-1">{{ d.event.title }}</a>
                    <span class="flex flex-wrap gap-1">{{ ui.slugchips(d.proposedSlugs) }}</span>
                    <span class="text-[11px] text-ink/30">{{ d.mode }}</span>
                    <form method="post" action="{{ path('admin_categorize_decide', {id: d.id, action: 'undo'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('categorize') }}">
                        <button class="text-xs text-ink/45 hover:text-rose-600 transition">rückgängig</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
