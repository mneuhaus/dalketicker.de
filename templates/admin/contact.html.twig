{% extends 'base.html.twig' %}

{% block title %}Kontakt – {{ site_name }}{% endblock %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-2 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight text-ink">Kontakt-Postfach</h1>
    </div>
    <p class="text-sm text-ink/50 mb-6">Nachrichten aus dem Kontaktformular. „Spam" ist die KI-Einschätzung – du kannst sie pro Nachricht korrigieren.</p>

    {# Tabs Echt / Spam #}
    <div class="inline-flex items-center rounded-xl bg-black/5 p-0.5 mb-6 text-sm">
        <a href="{{ path('admin_contact') }}" class="px-3.5 py-1.5 rounded-lg transition {{ view == 'real' ? 'bg-white shadow-sm text-ink font-semibold' : 'text-ink/60 hover:text-ink' }}">
            Echt <span class="text-ink/40">({{ counts.real }})</span>
        </a>
        <a href="{{ path('admin_contact', {filter: 'spam'}) }}" class="px-3.5 py-1.5 rounded-lg transition {{ view == 'spam' ? 'bg-white shadow-sm text-ink font-semibold' : 'text-ink/60 hover:text-ink' }}">
            Spam <span class="text-ink/40">({{ counts.spam }})</span>
        </a>
    </div>

    {% if messages is empty %}
        <div class="text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
            <p class="font-medium text-ink/70">{{ view == 'spam' ? 'Kein Spam.' : 'Noch keine Nachrichten.' }}</p>
        </div>
    {% else %}
        <div class="space-y-3">
            {% for m in messages %}
                <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-4">
                    <div class="flex items-start justify-between gap-3 mb-2">
                        <div class="min-w-0">
                            <div class="font-semibold text-ink">{{ m.name }}</div>
                            <a href="mailto:{{ m.email }}" class="text-sm text-brand-700 hover:underline break-all">{{ m.email }}</a>
                        </div>
                        <span class="text-xs text-ink/40 whitespace-nowrap shrink-0">{{ m.createdAt|date('d.m.Y H:i') }}</span>
                    </div>
                    <div class="text-sm text-ink/80 whitespace-pre-line border-l-2 border-black/10 pl-3 my-3">{{ m.message }}</div>
                    {% if m.spam and m.spamReason %}
                        <div class="text-xs text-rose-600/80 mb-2">KI: {{ m.spamReason }}</div>
                    {% endif %}
                    <div class="flex items-center gap-2 justify-end">
                        <form method="post" action="{{ path('admin_contact_toggle', {id: m.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('contact_admin') }}">
                            <input type="hidden" name="from" value="{{ view == 'spam' ? 'spam' : '' }}">
                            <button type="submit" class="chip-muted text-xs">{{ m.spam ? 'Kein Spam' : 'Als Spam markieren' }}</button>
                        </form>
                        <form method="post" action="{{ path('admin_contact_delete', {id: m.id}) }}" onsubmit="return confirm('Nachricht löschen?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('contact_admin') }}">
                            <input type="hidden" name="from" value="{{ view == 'spam' ? 'spam' : '' }}">
                            <button type="submit" class="text-xs text-rose-600/70 hover:text-rose-700 px-2 py-1">Löschen</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
