{% extends 'base.html.twig' %}

{% block title %}Statistik – {{ site_name }}{% endblock %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% block body %}
    {% set labels = {
        'event_index': 'Liste',
        'event_month': 'Monat',
        'event_week': 'Woche',
        'event_surprise': 'Überrasch mich',
        'event_show': 'Event-Detail',
        'page_quellen': 'Quellen',
        'page_datenschutz': 'Datenschutz',
        'page_impressum': 'Impressum'
    } %}

    <div class="flex items-center justify-between mb-6 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-extrabold tracking-tight text-ink">Statistik</h1>
    </div>

    <p class="text-sm text-ink/50 mb-6">
        Anonyme Zählung ohne Cookies, ohne Tracking – nur aggregierte Zahlen. „Besucher" ist eine grobe Schätzung
        (tagesbezogener, gesalzener Hash, keine IP gespeichert).
    </p>

    {# Totals (last 30 days) #}
    {# Two rows: Aufrufe / Besucher, each heute · 7 Tage · 30 Tage. #}
    <div class="space-y-3 mb-8">
        {% for row in [{label: 'Aufrufe', data: metrics.views}, {label: 'Besucher (grob)', data: metrics.visitors}] %}
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-ink/40 mb-1.5">{{ row.label }}</div>
                <div class="grid grid-cols-3 gap-3">
                    {% for p in [{k: 'heute', l: 'heute'}, {k: '7', l: '7 Tage'}, {k: '30', l: '30 Tage'}] %}
                        <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-5">
                            <div class="text-3xl font-bold text-ink tabular-nums font-[family-name:var(--font-display)]">{{ row.data[p.k] }}</div>
                            <div class="text-xs text-ink/50 mt-0.5">{{ p.l }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

    {# Verlauf (letzte 30 Tage) als SVG-Chart mit zwei Skalen:
       Aufrufe (gefüllt, linke Achse) + Besucher (gestrichelt, rechte Achse). #}
    {% set W = 720 %}{% set H = 180 %}{% set top = 0 %}
    {% set n = series|length %}
    {% set slot = (W / (n - 1))|round(2) %}
    {% set viewsPts = [] %}{% set visPts = [] %}
    {% for d in series %}
        {% set x = (loop.index0 / (n - 1) * W)|round(2) %}
        {% set yv = (H - (d.views / maxViews) * (H - top))|round(2) %}
        {% set yp = (H - (d.visitors / maxVisitors) * (H - top))|round(2) %}
        {% set viewsPts = viewsPts|merge([x ~ ',' ~ yv]) %}
        {% set visPts = visPts|merge([x ~ ',' ~ yp]) %}
    {% endfor %}

    <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink">Verlauf (letzte 30 Tage)</h2>
        <div class="flex items-center gap-4 text-xs text-ink/55">
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-1.5 rounded-full bg-brand-500"></span>Aufrufe</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-0 border-t-2 border-dashed border-ink/50"></span>Besucher</span>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-4 mb-8">
        <div class="flex gap-2">
            {# Linke Achse: Aufrufe #}
            <div class="flex flex-col justify-between text-right text-[11px] tabular-nums font-medium text-brand-600 shrink-0 w-10" style="height: 200px">
                <span>{{ maxViews }}</span>
                <span class="text-brand-600/60">{{ (maxViews / 2)|round }}</span>
                <span class="text-brand-600/60">0</span>
            </div>
            <div class="flex-1 min-w-0">
                <svg viewBox="0 0 {{ W }} {{ H }}" class="w-full block" style="height: 200px; overflow: visible" preserveAspectRatio="none" role="img" aria-label="Besuchsverlauf der letzten 30 Tage">
                    <defs>
                        <linearGradient id="viewsFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#06b0c4" stop-opacity="0.20"/>
                            <stop offset="100%" stop-color="#06b0c4" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    {# Horizontale Gitterlinien bei 0/25/50/75/100 % (Achsenwerte) #}
                    {% for f in [0, 0.25, 0.5, 0.75, 1] %}
                        <line x1="0" y1="{{ (H * (1 - f))|round(2) }}" x2="{{ W }}" y2="{{ (H * (1 - f))|round(2) }}"
                              stroke="#000" stroke-opacity="{{ f in [0, 0.5, 1] ? '0.10' : '0.05' }}" stroke-width="1" vector-effect="non-scaling-stroke"/>
                    {% endfor %}
                    <polygon points="{{ viewsPts|join(' ') }} {{ W }},{{ H }} 0,{{ H }}" fill="url(#viewsFill)"/>
                    <polyline points="{{ viewsPts|join(' ') }}" fill="none" stroke="#06b0c4" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
                    <polyline points="{{ visPts|join(' ') }}" fill="none" stroke="#1b1d1e" stroke-opacity="0.45" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="4 3" vector-effect="non-scaling-stroke"/>
                    {# Sichtbare Datenpunkte #}
                    {% for d in series %}
                        {% set x = (loop.index0 / (n - 1) * W)|round(2) %}
                        <circle cx="{{ x }}" cy="{{ (H - (d.visitors / maxVisitors) * H)|round(2) }}" r="2.2" fill="#1b1d1e" fill-opacity="0.45"/>
                        <circle cx="{{ x }}" cy="{{ (H - (d.views / maxViews) * H)|round(2) }}" r="2.8" fill="#06b0c4"/>
                    {% endfor %}
                    {# Hover-Zone pro Tag (volle Höhe) → Popup mit genauen Zahlen #}
                    {% for d in series %}
                        {% set x = (loop.index0 / (n - 1) * W)|round(2) %}
                        <rect x="{{ (x - slot / 2)|round(2) }}" y="0" width="{{ slot }}" height="{{ H }}" fill="transparent">
                            <title>{{ d.day|date('d.m.Y') }} — {{ d.views }} Aufrufe · {{ d.visitors }} Besucher</title>
                        </rect>
                    {% endfor %}
                </svg>
            </div>
            {# Rechte Achse: Besucher #}
            <div class="flex flex-col justify-between text-left text-[11px] tabular-nums font-medium text-ink/60 shrink-0 w-10" style="height: 200px">
                <span>{{ maxVisitors }}</span>
                <span class="text-ink/40">{{ (maxVisitors / 2)|round }}</span>
                <span class="text-ink/40">0</span>
            </div>
        </div>
        {# Datumsachse (unter dem Chart, mit Abstandshaltern für die Y-Achsen) #}
        <div class="flex gap-2 mt-1">
            <div class="w-10 shrink-0"></div>
            <div class="flex-1 flex justify-between text-[11px] text-ink/40 tabular-nums px-0.5">
                <span>{{ series|first.day|date('d.m.') }}</span>
                <span>{{ series[(n // 2)].day|date('d.m.') }}</span>
                <span>{{ series|last.day|date('d.m.') }}</span>
            </div>
            <div class="w-10 shrink-0"></div>
        </div>
    </div>

    {# Top pages #}
    <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink mb-2">Top-Seiten (30 Tage)</h2>
    <div class="bg-white rounded-2xl border border-black/5 shadow-sm divide-y divide-black/5">
        {% for p in pages %}
            <div class="flex items-center gap-4 px-4 py-2.5 text-sm">
                <span class="font-medium text-ink flex-1">{{ labels[p.route_key] ?? p.route_key }}</span>
                <span class="text-ink/50 tabular-nums">{{ p.views }}</span>
            </div>
        {% else %}
            <div class="px-4 py-6 text-ink/40 text-sm">Noch keine Daten erfasst.</div>
        {% endfor %}
    </div>

    {# Most popular individual events (detail-page views). #}
    <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink mb-2 mt-8">Beliebteste Events (30 Tage)</h2>
    <div class="bg-white rounded-2xl border border-black/5 shadow-sm divide-y divide-black/5">
        {% for ev in topEvents %}
            <div class="flex items-center gap-4 px-4 py-2.5 text-sm">
                <span class="text-ink/30 tabular-nums w-5 text-right">{{ loop.index }}</span>
                <a href="https://{{ ev.canonical_host }}{{ path('event_show', {id: ev.id, slug: ev.slug}) }}" target="_blank" rel="noopener" class="font-medium text-ink flex-1 line-clamp-1 hover:text-brand-700">{{ ev.title }}</a>
                <span class="text-ink/50 tabular-nums">{{ ev.views }}</span>
            </div>
        {% else %}
            <div class="px-4 py-6 text-ink/40 text-sm">Noch keine Detailseiten-Aufrufe erfasst.</div>
        {% endfor %}
    </div>
{% endblock %}
