{% extends 'base.html.twig' %}

{% block title %}AI-Dedup – {{ site_name }}{% endblock %}

{# A small event preview, styled like a list card. `kept` = the canonical event
   (normal colours); otherwise the hidden duplicate (greyed + struck through). #}
{% macro preview(event, kept) %}
    <div class="relative rounded-xl border border-black/5 overflow-hidden bg-white {{ kept ? '' : 'opacity-55 grayscale' }}">
        <span class="absolute top-2 left-2 z-10 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold {{ kept ? 'bg-emerald-600 text-white' : 'bg-black/60 text-white' }}">
            {{ kept ? 'Behalten' : 'Ausgeblendet' }}
        </span>
        {% if event %}
            <div class="aspect-[16/9] bg-black/5">
                {% if event.imageUrl %}
                    {# Raw source URL (admin preview): the proxy only serves images cleared for public display. #}
                    <img src="{{ event.imageUrl }}" alt="" loading="lazy" class="w-full h-full object-cover">
                {% else %}
                    <div class="w-full h-full flex items-center justify-center text-ink/25 text-xs">kein Bild</div>
                {% endif %}
            </div>
            <div class="p-3">
                <div class="flex flex-wrap items-center gap-1.5 mb-1">
                    {% for category in event.categories %}
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold text-white whitespace-nowrap" style="background-color: {{ category.color }}">{{ category.name }}</span>
                    {% endfor %}
                </div>
                <h3 class="font-[family-name:var(--font-display)] text-sm font-bold text-ink leading-snug line-clamp-2 {{ kept ? '' : 'line-through' }}">{{ event.title }}</h3>
                <div class="mt-0.5 text-xs font-semibold text-brand-700">{% if event.allDay %}ganztägig{% else %}{{ event.startsAt|date('H:i') }} Uhr{% endif %}</div>
                {% if event.displayLocation %}<div class="mt-0.5 text-xs text-ink/50 truncate">{{ event.displayLocation }}</div>{% endif %}
                <div class="mt-1 text-[10px] text-ink/30">{{ event.source.key }}</div>
            </div>
        {% else %}
            <div class="aspect-[16/9] bg-black/5 flex items-center justify-center text-ink/30 text-xs">gelöscht</div>
        {% endif %}
    </div>
{% endmacro %}
{% import _self as dd %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% block body %}

    <div class="flex items-center justify-between mb-2 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight text-ink">AI-Deduplizierung</h1>
        <div class="flex items-center gap-3 shrink-0">
            <span class="text-xs text-ink/40">{{ decisions|length }} aktive Merges</span>
            {% if configured %}
                <form method="post" action="{{ path('admin_dedup_run', admin_region_params()) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('dedup_run') }}">
                    <button type="submit" class="rounded-full bg-brand-700 text-white text-xs font-semibold px-3.5 py-1.5 hover:bg-brand-800 transition-colors">Jetzt prüfen</button>
                </form>
            {% else %}
                <span class="text-xs text-rose-600">Kein API-Key gesetzt</span>
            {% endif %}
        </div>
    </div>
    <p class="text-sm text-ink/50 mb-6">Vom KI-Pass zusammengeführte Duplikate. „Rückgängig" macht das ausgeblendete Event wieder sichtbar.{% if configured %} „Jetzt prüfen" startet einen Durchlauf der nächsten 60 Tage im Hintergrund (Modell {{ model }}).{% endif %}</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 rounded-xl px-4 py-2.5 text-sm {{ label == 'success' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-700' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if decisions is empty %}
        <div class="text-center py-16 text-ink/50 border border-dashed border-black/10 rounded-2xl">
            <p class="font-medium text-ink/70">Noch keine KI-Merges.</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for d in decisions %}
                <div class="bg-white rounded-2xl border border-black/5 shadow-sm p-4">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="min-w-0">
                            <span class="text-xs font-semibold text-ink/50">{{ d.day|date('d.m.Y') }}</span>
                            {% if d.reason %}<p class="text-sm text-ink/55 mt-0.5">{{ d.reason }}</p>{% endif %}
                        </div>
                        {% if d.duplicateEvent %}
                            <form method="post" action="{{ path('admin_dedup_undo', admin_region_params({id: d.id})) }}" class="shrink-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('dedup_undo') }}">
                                <button type="submit" class="chip-muted text-xs">Rückgängig</button>
                            </form>
                        {% endif %}
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {{ dd.preview(d.canonicalEvent, true) }}
                        {{ dd.preview(d.duplicateEvent, false) }}
                    </div>
                    <div class="text-[11px] text-ink/30 mt-2">{{ d.model }} · {{ d.createdAt|date('d.m.Y H:i') }}</div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
