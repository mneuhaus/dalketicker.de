{% extends 'base.html.twig' %}

{% block title %}Quellen – {{ site_name }}{% endblock %}

{% macro status_badge(status) %}
    {% set map = {'ok': 'bg-emerald-100 text-emerald-800', 'partial': 'bg-amber-100 text-amber-800', 'failed': 'bg-rose-100 text-rose-700', 'running': 'bg-sky-100 text-sky-800'} %}
    {% set label = {'ok': 'OK', 'partial': 'Teilweise', 'failed': 'Fehler', 'running': 'Läuft'} %}
    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ map[status] ?? 'bg-black/10 text-ink/60' }}">{{ label[status] ?? status }}</span>
{% endmacro %}

{% block subheader %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% block body %}
    {% import _self as ui %}
    <div class="flex items-center justify-between mb-6 gap-4">
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-extrabold tracking-tight text-ink">Quellen</h1>
    </div>

    <p class="text-sm text-ink/50 mb-6">
        Automatischer Import: täglich um <strong class="text-ink/70">06:00</strong> und <strong class="text-ink/70">18:00</strong> Uhr{% if lastRun %} · letzter Lauf {{ lastRun.startedAt|de_date }}, {{ lastRun.startedAt|date('H:i') }} Uhr{% endif %}.
    </p>

    <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink">Quellen</h2>
        <span class="text-xs text-ink/40">„noch nie" = inaktive Quelle (wird nicht importiert)</span>
    </div>

    <div class="bg-white rounded-2xl border border-black/5 shadow-sm overflow-hidden mb-8">
        <table class="w-full text-sm">
            <thead class="text-left text-xs uppercase tracking-wide text-ink/40 border-b border-black/5">
                <tr>
                    <th class="px-4 py-3">Quelle</th>
                    <th class="px-4 py-3">Importer</th>
                    <th class="px-4 py-3">Letzter Lauf</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">gesehen / neu / Fehler</th>
                    <th class="px-4 py-3 text-right">Dauer</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-black/5">
                {% for source in sources %}
                    {% set run = latest[source.id] ?? null %}
                    <tr class="{{ source.enabled ? '' : 'opacity-50' }}">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <a href="{{ path('admin_source', {id: source.id}) }}" class="font-medium text-ink hover:text-brand-700 hover:underline">{{ source.name }}</a>
                                {% if source.factsOnly %}
                                    <span class="inline-flex items-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold text-amber-800" title="Aggregator">Aggr.</span>
                                {% else %}
                                    <span class="inline-flex items-center rounded-full bg-brand-100 px-1.5 py-0.5 text-[10px] font-semibold text-brand-800" title="Primärquelle">Primär</span>
                                {% endif %}
                                {% if source.approved %}<span class="inline-flex items-center rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-800" title="Freigabe vorhanden">frei</span>{% endif %}
                                {% set warn = warnings[source.id] ?? null %}
                                {% if warn %}
                                    {% if warn.failed %}
                                        <span class="inline-flex items-center rounded-full bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-700" title="{{ warn.failed|slice(0, 300) }}">Lauf fehlgeschlagen</span>
                                    {% endif %}
                                    {% if warn.staleDays %}
                                        <span class="inline-flex items-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold text-amber-800" title="Kein erfolgreicher Lauf seit {{ warn.staleDays }} Tagen">zuletzt vor {{ warn.staleDays }} Tagen</span>
                                    {% endif %}
                                    {% if warn.zeroEvents %}
                                        <span class="inline-flex items-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold text-amber-800" title="Die letzten 3 Läufe haben keine Events gesehen">liefert 0 Events</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                            <div class="text-xs text-ink/40">{{ source.key }}{% if not source.enabled %} · inaktiv{% endif %}</div>
                        </td>
                        <td class="px-4 py-3 text-ink/60">{{ source.importer }}</td>
                        <td class="px-4 py-3 text-ink/60">
                            {% if run %}<a href="{{ path('admin_import_run', {id: run.id}) }}" class="text-brand-700 hover:underline">{{ run.startedAt|de_date }}, {{ run.startedAt|date('H:i') }}</a>{% else %}–{% endif %}
                        </td>
                        <td class="px-4 py-3">{{ run ? ui.status_badge(run.status) : '<span class="text-ink/30">noch nie</span>'|raw }}</td>
                        <td class="px-4 py-3 text-right tabular-nums">
                            {% if run %}{{ run.seen }} / {{ run.created }} / <span class="{{ run.errors > 0 ? 'text-rose-600 font-semibold' : 'text-ink/40' }}">{{ run.errors }}</span>{% else %}–{% endif %}
                        </td>
                        <td class="px-4 py-3 text-right text-ink/50">{{ run ? (run.durationMs / 1000)|round(1) ~ ' s' : '–' }}</td>
                    </tr>
                    {% if run and run.status == 'failed' and run.message %}
                        <tr class="bg-rose-50/50"><td colspan="6" class="px-4 py-2 text-xs text-rose-700 font-mono">{{ run.message|slice(0, 300) }}</td></tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-[family-name:var(--font-display)] text-lg font-bold text-ink">Verlauf</h2>
        <span class="text-xs text-ink/40">chronologisch über alle Quellen · für Details anklicken</span>
    </div>
    <div class="bg-white rounded-2xl border border-black/5 shadow-sm divide-y divide-black/5">
        {% for run in recent %}
            <a href="{{ path('admin_import_run', {id: run.id}) }}" class="flex items-center gap-4 px-4 py-2.5 text-sm hover:bg-black/[0.02] transition">
                <span class="text-ink/40 text-xs w-28 shrink-0">{{ run.startedAt|de_date }} {{ run.startedAt|date('H:i') }}</span>
                <span class="font-medium text-ink flex-1 truncate">{{ run.source.name }}</span>
                {{ ui.status_badge(run.status) }}
                <span class="text-ink/50 tabular-nums w-44 text-right">{{ run.seen }} ges. · {{ run.created }} neu · {{ run.errors }} Fehler</span>
            </a>
        {% else %}
            <div class="px-4 py-6 text-ink/40 text-sm">Noch keine Läufe aufgezeichnet.</div>
        {% endfor %}
    </div>
{% endblock %}
