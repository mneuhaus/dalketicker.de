<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site_name }} – {{ site_tagline }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Alle Veranstaltungen im Kreis Gütersloh an einem Ort – Konzerte, Sport, Familie, Kultur und mehr. Endlich übersichtlich.{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%230a8da3%22/><g fill=%22none%22 stroke=%22%23fff%22 stroke-width=%222.4%22 stroke-linecap=%22round%22><path d=%22M6 12c2.5-2.4 5-2.4 7.5 0s5 2.4 7.5 0 5-2.4 5 0%22/><path d=%22M6 19c2.5-2.4 5-2.4 7.5 0s5 2.4 7.5 0 5-2.4 5 0%22/></g></svg>">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    <div class="river-rule h-1 w-full"></div>

    <header class="border-b border-black/5 bg-paper/90 backdrop-blur sticky top-0 z-30">
        <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-2 sm:gap-4">
            <a href="{{ path('event_index') }}" class="flex items-center gap-2.5 group">
                {{ include('_logo.html.twig') }}
                <span class="leading-tight">
                    <span class="block font-[family-name:var(--font-display)] text-lg sm:text-xl font-extrabold tracking-tight text-ink group-hover:text-brand-700 transition">{{ site_name }}</span>
                    <span class="hidden sm:block text-xs text-ink/50 -mt-0.5">{{ site_tagline }}</span>
                </span>
            </a>
            {% set meineActive = app.request.query.get('meine') == '1' %}
            {% set segActive = 'bg-white shadow-sm text-ink' %}
            {% set segIdle = 'text-ink/60 hover:text-ink' %}
            <nav class="flex items-center gap-1.5 sm:gap-3 text-sm font-medium">
                <div class="inline-flex items-center rounded-xl bg-black/5 p-0.5">
                    <a href="{{ path('event_index') }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'list' and not meineActive ? segActive : segIdle }}">Liste</a>
                    <a href="{{ path('event_week', {year: 'now'|date('o'), week: 'now'|date('W')}) }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'week' ? segActive : segIdle }}">Woche</a>
                    <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'month' ? segActive : segIdle }}">Monat</a>
                </div>
                <span class="hidden sm:inline text-ink/20" aria-hidden="true">|</span>
                <a href="{{ meineActive ? path('event_index') : path('event_index', {meine: 1}) }}" data-meine-nav
                   class="px-2.5 sm:px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 {{ meineActive ? 'bg-brand-600 text-white' : 'text-ink/70 hover:bg-black/5' }}">
                    <svg class="w-4 h-4" fill="{{ meineActive ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    <span class="hidden sm:inline">Meine Events</span>
                    <span data-save-count class="hidden min-w-5 h-5 px-1.5 inline-flex items-center justify-center rounded-full text-xs font-semibold {{ meineActive ? 'bg-white/25 text-white' : 'bg-brand-100 text-brand-800' }}">0</span>
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl w-full px-4 py-6">
        {% block body %}{% endblock %}
    </main>

    <footer class="border-t border-black/5 mt-10">
        <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-ink/50 flex flex-col sm:flex-row justify-between gap-4">
            <p>
                <strong class="text-ink/70">{{ site_name }}</strong> · aggregiert Veranstaltungen aus dem Kreis Gütersloh.<br>
                Alle Angaben ohne Gewähr – maßgeblich ist immer der Veranstalter.
            </p>
            <nav class="flex flex-col gap-1 sm:text-right">
                <a href="{{ path('page_quellen') }}" class="hover:text-brand-700">Quellen &amp; Hinweise</a>
                <a href="{{ path('page_datenschutz') }}" class="hover:text-brand-700">Datenschutz</a>
                <a href="{{ path('page_impressum') }}" class="hover:text-brand-700">Impressum</a>
            </nav>
        </div>
    </footer>
</body>
</html>
