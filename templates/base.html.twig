<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site_name }} – {{ site_tagline }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Alle Veranstaltungen {{ current_region.areaInPhrase }} an einem Ort – Konzerte, Sport, Familie, Kultur und mehr. Endlich übersichtlich.{% endblock %}">

    {# Canonical/og:url always point at the region's canonical host so alias
       hosts (www., *.neuhaus.nrw) aren't indexed as duplicate sites. The page
       number is part of it (page 2 is its own document, not a copy of page 1);
       filters are deliberately left off. #}
    {% set canonical_page = app.request.query.getInt('seite') %}
    {% set canonical_url = current_region.baseUrl ~ app.request.pathInfo ~ (canonical_page > 1 ? '?seite=' ~ canonical_page : '') %}

    {# Link-Vorschau (Open Graph / Twitter) – greift in WhatsApp, Signal, Telegram, iMessage, Facebook … #}
    {% block og %}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="{{ site_name }}">
        <meta property="og:locale" content="de_DE">
        <meta property="og:title" content="{% block og_title %}{{ site_name }} – {{ site_tagline }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ canonical_url }}">
        <meta property="og:image" content="{% block og_image %}{{ region_share_image() }}{% endblock %}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
    {% endblock %}
    {% set favicon_letter_y = current_region.logoLetter == 'p' ? '22.6' : (current_region.logoLetter == 's' ? '23.0' : '23.5') %}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%227%22 fill=%22{{ current_region.themeColor|replace({'#': '%23'}) }}%22/><text x=%2216%22 y=%22{{ favicon_letter_y }}%22 text-anchor=%22middle%22 font-family=%22Helvetica,Arial,sans-serif%22 font-size=%2224%22 font-weight=%22700%22 fill=%22%23fff%22>{{ current_region.logoLetter }}</text></svg>">
    {# Installable as a home-screen app (no store; offered via the App page and the mobile badge). #}
    <link rel="manifest" href="{{ path('site_manifest') }}">
    <meta name="theme-color" content="{{ current_region.themeColor }}">
    <link rel="apple-touch-icon" href="{{ path('apple_touch_icon') }}">
    <meta name="apple-mobile-web-app-title" content="{{ site_name }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="canonical" href="{{ canonical_url }}">
    {% block head_links %}{% endblock %}
    {% block stylesheets %}
        {# Linked directly (not imported via JS) so the browser applies it
           immediately and no data:-URI CSS module ends up in the importmap. #}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col {{ view|default('') == 'surprise' ? 'pb-20 md:pb-0' : '' }}"
      style="--region-color: {{ current_region.themeColor }}; --color-brand-50: color-mix(in srgb, var(--region-color), white 94%); --color-brand-100: color-mix(in srgb, var(--region-color), white 84%); --color-brand-200: color-mix(in srgb, var(--region-color), white 70%); --color-brand-300: color-mix(in srgb, var(--region-color), white 52%); --color-brand-400: color-mix(in srgb, var(--region-color), white 28%); --color-brand-500: color-mix(in srgb, var(--region-color), white 10%); --color-brand-600: var(--region-color); --color-brand-700: color-mix(in srgb, var(--region-color), black 18%); --color-brand-800: color-mix(in srgb, var(--region-color), black 34%); --color-brand-900: color-mix(in srgb, var(--region-color), black 48%); --color-brand-950: color-mix(in srgb, var(--region-color), black 62%);">
    <div class="river-rule h-1 w-full"></div>

    {# Header + (on list views) the mobile filter bar stick to the top together. #}
    <div class="sticky top-0 z-30">
    <header class="border-b border-black/5 bg-paper/90 backdrop-blur">
        <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-2 sm:gap-4">
            <a href="{{ path('event_index') }}" class="flex items-center gap-2.5 group">
                {{ include('_logo.html.twig') }}
                <span class="leading-tight">
                    <span class="block font-[family-name:var(--font-display)] text-lg sm:text-xl font-extrabold tracking-tight text-ink group-hover:text-brand-700 transition">{{ site_name }}</span>
                    <span class="hidden sm:block text-xs text-ink/50 -mt-0.5">{{ site_tagline }}</span>
                </span>
            </a>
            {% set meineActive = app.request.query.get('meine') == '1' %}
            {% set segActive = 'bg-white shadow-sm text-ink' %}
            {% set segIdle = 'text-ink/60 hover:text-ink' %}
            <nav class="flex items-center gap-1.5 sm:gap-3 text-sm font-medium">
                <div class="inline-flex items-center rounded-xl bg-black/5 p-0.5">
                    <a href="{{ path('event_index') }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'list' and not meineActive ? segActive : segIdle }}">Liste</a>
                    <a href="{{ path('event_surprise') }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'surprise' ? segActive : segIdle }}">Heute?</a>
                    <a href="{{ path('event_month', {year: 'now'|date('Y'), month: 'now'|date('n')}) }}" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition {{ view|default('') == 'month' ? segActive : segIdle }}">Monat</a>
                </div>
                <span class="hidden sm:inline text-ink/20" aria-hidden="true">|</span>
                <a href="{{ meineActive ? path('event_index') : path('event_index', {meine: 1}) }}" data-meine-nav
                   class="px-2.5 sm:px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 {{ meineActive ? 'bg-brand-600 text-white' : 'text-ink/70 hover:bg-black/5' }}">
                    <svg class="w-4 h-4" fill="{{ meineActive ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    {# Below sm only the icon + count are visible; the sr-only copy keeps
                       the link's accessible name from collapsing to a bare digit. #}
                    <span class="sr-only">Meine Events</span>
                    <span class="hidden sm:inline" aria-hidden="true">Meine Events</span>
                    <span data-save-count class="hidden min-w-5 h-5 px-1.5 items-center justify-center rounded-full text-xs font-semibold {{ meineActive ? 'bg-white/25 text-white' : 'bg-brand-100 text-brand-800' }}">0</span>
                </a>
            </nav>
        </div>
    </header>
        {% block subheader %}{% endblock %}
    </div>

    <main class="flex-1 mx-auto max-w-6xl w-full px-4 py-6">
        {% block body %}{% endblock %}
    </main>

    <footer class="border-t border-black/5 mt-10 text-sm text-ink/50">
        {# Mobile: centred — links as one row, tagline quietly below. #}
        <div class="sm:hidden mx-auto max-w-6xl px-4 py-7 flex flex-col items-center text-center gap-3">
            <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-medium text-ink/70">
                <a href="{{ path('page_quellen') }}" class="hover:text-brand-700">Quellen &amp; Hinweise</a>
                <span class="text-ink/25" aria-hidden="true">·</span>
                <a href="{{ path('page_datenschutz') }}" class="hover:text-brand-700">Datenschutz</a>
                <span class="text-ink/25" aria-hidden="true">·</span>
                <a href="{{ path('page_impressum') }}" class="hover:text-brand-700">Impressum</a>
                <span class="text-ink/25" aria-hidden="true">·</span>
                <a href="https://github.com/mneuhaus/dalketicker.de" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-brand-700">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    Code
                </a>
            </nav>
            <a href="{{ path('page_app') }}" class="inline-flex items-center gap-1.5 rounded-full border border-black/10 px-3.5 py-1.5 font-medium text-ink/70 hover:border-brand-300 hover:text-brand-700 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                Als App speichern
            </a>
            <p class="text-xs text-ink/45 leading-relaxed max-w-xs">
                <strong class="text-ink/60">{{ site_name }}</strong> aggregiert Veranstaltungen {{ current_region.areaFromPhrase }} – alle Angaben ohne Gewähr.
            </p>
        </div>
        {# Desktop: tagline left, links right. #}
        <div class="hidden sm:flex mx-auto max-w-6xl px-4 py-8 justify-between gap-4">
            <p>
                <strong class="text-ink/70">{{ site_name }}</strong> · aggregiert Veranstaltungen {{ current_region.areaFromPhrase }}.<br>
                Alle Angaben ohne Gewähr – maßgeblich ist immer der Veranstalter.
            </p>
            <nav class="flex flex-col gap-1 items-end text-right">
                <a href="{{ path('page_quellen') }}" class="hover:text-brand-700">Quellen &amp; Hinweise</a>
                <a href="{{ path('page_datenschutz') }}" class="hover:text-brand-700">Datenschutz</a>
                <a href="{{ path('page_impressum') }}" class="hover:text-brand-700">Impressum</a>
                <a href="https://github.com/mneuhaus/dalketicker.de" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-brand-700">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    Quellcode auf GitHub
                </a>
            </nav>
        </div>
    </footer>

    <aside data-install-badge hidden
           class="install-badge fixed inset-x-3 mx-auto max-w-md z-50 rounded-2xl bg-white text-ink shadow-[0_18px_60px_rgba(0,0,0,0.16),0_1px_0_rgba(255,255,255,0.7)_inset] ring-1 ring-black/10 overflow-hidden">
        {% set install_logo_letter_offset = current_region.logoLetter == 'p' ? '-0.08em' : (current_region.logoLetter == 's' ? '-0.045em' : '0') %}
        <div class="flex items-stretch">
            <a href="{{ path('page_app') }}" data-install-badge-action
               class="min-w-0 flex-1 flex items-center gap-3 px-3.5 py-3 text-left hover:bg-brand-50 transition-colors">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl shrink-0 bg-brand-600 text-white shadow-sm">
                    <span class="inline-block font-[family-name:var(--font-display)] text-[2rem] font-bold leading-none" style="transform: translateY({{ install_logo_letter_offset }});">{{ current_region.logoLetter }}</span>
                </span>
                <span class="min-w-0">
                    <span class="block text-sm font-bold leading-tight text-ink">{{ site_name }} als App speichern</span>
                    <span data-install-badge-mode="ios" class="block text-xs leading-snug text-ink/55">Auf dem iPhone über Teilen zum Home-Bildschirm.</span>
                    <span data-install-badge-mode="prompt" hidden class="block text-xs leading-snug text-ink/55">Direkt als Homescreen-App installieren.</span>
                </span>
            </a>
            <button type="button" data-install-badge-close
                    class="w-12 shrink-0 inline-flex items-center justify-center text-ink/45 hover:text-ink hover:bg-black/5 active:scale-[0.96] transition-[color,background-color,scale]"
                    aria-label="App-Hinweis ausblenden">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
    </aside>
</body>
</html>
